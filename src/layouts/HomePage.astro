---
import '@fontsource-variable/tektur'
import '@fontsource/faster-one'
import '@fontsource/monoton'
import '@fontsource/ponomar'
import '@fontsource/old-standard-tt'
import '@fontsource-variable/onest'
import '@fontsource-variable/jetbrains-mono'
import BrandMark from '../components/BrandMark.astro'
import HeroScene from '../components/HeroScene.tsx'
import { SITE, SOURCE_REPOSITORY, translations, type Lang } from '../i18n.ts'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = translations[lang]
const canonical = lang === 'ru' ? `${SITE}/` : `${SITE}/en/`

// ── Air-support cylinders, generated once at build time ──────────────
// Nine approved nested ellipses, each extruded upward into a continuous
// translucent cylinder wall. The two half-surfaces are painted on
// opposite sides of the copy, so the content really sits inside the
// tubes instead of behind a fence of disconnected vertical lines.
interface OvalLane {
  rx: number
  ry: number
  color: string
  dur: number
  delay: number
  peak: number
  rev: boolean
}
const OVAL_LANES: OvalLane[] = [
  { rx: 560, ry: 132, color: '#0a5236', dur: 6.8, delay: -1.2, peak: 0.55, rev: false },
  { rx: 537, ry: 124, color: '#0f6e4a', dur: 8.2, delay: -4.6, peak: 0.66, rev: true },
  { rx: 515, ry: 116, color: '#0e8f5a', dur: 5.9, delay: -2.3, peak: 0.76, rev: false },
  { rx: 492, ry: 108, color: '#12a568', dur: 7.5, delay: -5.8, peak: 0.86, rev: true },
  { rx: 470, ry: 100, color: '#14b874', dur: 6.2, delay: -0.7, peak: 0.95, rev: false },
  { rx: 447, ry: 92, color: '#18d383', dur: 8.8, delay: -3.9, peak: 1, rev: true },
  { rx: 425, ry: 84, color: '#1fe097', dur: 7.1, delay: -6.4, peak: 0.9, rev: false },
  { rx: 403, ry: 76, color: '#25f09e', dur: 6.5, delay: -2.9, peak: 0.82, rev: true },
  { rx: 382, ry: 68, color: '#4be8b3', dur: 9.3, delay: -5.2, peak: 0.72, rev: false },
]
const OVAL_CX = 600
const OVAL_BASE_CY = 232
const OVAL_RISE = 52
const OVAL_TOP_CY = OVAL_BASE_CY - OVAL_RISE
const OVAL_MID_CY = OVAL_BASE_CY - OVAL_RISE / 2

const ovalFarArc = (lane: OvalLane, cy: number) =>
  `M ${OVAL_CX - lane.rx} ${cy} A ${lane.rx} ${lane.ry} 0 1 1 ${OVAL_CX + lane.rx} ${cy}`
const ovalNearArc = (lane: OvalLane, cy: number) =>
  `M ${OVAL_CX + lane.rx} ${cy} A ${lane.rx} ${lane.ry} 0 1 1 ${OVAL_CX - lane.rx} ${cy}`

// Extruding a line creates a surface, not a row of posts. Each path is
// the closed strip between the same ellipse half at the base and top.
const ovalFarWall = (lane: OvalLane) =>
  `M ${OVAL_CX - lane.rx} ${OVAL_BASE_CY} ` +
  `A ${lane.rx} ${lane.ry} 0 1 1 ${OVAL_CX + lane.rx} ${OVAL_BASE_CY} ` +
  `L ${OVAL_CX + lane.rx} ${OVAL_TOP_CY} ` +
  `A ${lane.rx} ${lane.ry} 0 1 0 ${OVAL_CX - lane.rx} ${OVAL_TOP_CY} Z`
const ovalNearWall = (lane: OvalLane) =>
  `M ${OVAL_CX + lane.rx} ${OVAL_BASE_CY} ` +
  `A ${lane.rx} ${lane.ry} 0 1 1 ${OVAL_CX - lane.rx} ${OVAL_BASE_CY} ` +
  `L ${OVAL_CX - lane.rx} ${OVAL_TOP_CY} ` +
  `A ${lane.rx} ${lane.ry} 0 1 0 ${OVAL_CX + lane.rx} ${OVAL_TOP_CY} Z`

// The oval is on screen for one short act, so its entrance and exit are
// authored as a compact depth sequence rather than one global fade. Walls
// travel outside-in; their extruded panels follow; the near half arrives last.
// Exit reverses both directions so the copy is released before the card lands.
const ovalLaneStyle = (lane: OvalLane, index: number, front: boolean) => {
  const inwardStep = index * 0.055
  const outwardStep = (OVAL_LANES.length - 1 - index) * 0.03
  const laneEnter = (front ? 0.32 : 0.04) + inwardStep
  const panelEnter = (front ? 0.48 : 0.2) + inwardStep
  const laneExit = (front ? 0.14 : 0.42) + outwardStep
  const panelExit = (front ? 0 : 0.28) + outwardStep

  return [
    `--dur:${lane.dur}s`,
    `--delay:${lane.delay}s`,
    `--peak:${lane.peak}`,
    `--lane-color:${lane.color}`,
    `--lane-enter:${laneEnter.toFixed(3)}s`,
    `--panel-enter:${panelEnter.toFixed(3)}s`,
    `--lane-exit:${laneExit.toFixed(3)}s`,
    `--panel-exit:${panelExit.toFixed(3)}s`,
  ].join(';')
}

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'SonicXBoy',
  jobTitle: 'WebGL Developer and Interactive Product Creator',
  url: `${SITE}/`,
  description: t.jsonLdDescription,
  knowsAbout: [
    'Three.js',
    'WebGL',
    'WebGPU',
    'GLSL',
    'React Three Fiber',
    'Mapbox',
    'React',
    'TypeScript',
    'Next.js',
    'Astro',
    'Node.js',
    'Browser Extensions',
    'Chrome Extensions',
    'Manifest V3',
    'Interactive 3D Graphics',
    '3D Product Configurators',
    'Data Visualization',
    'WebGL Performance Optimization',
    'Performance Engineering',
    'AI-assisted Software Development',
    'GSAP',
    'Blender',
  ],
  knowsLanguage: ['ru', 'en'],
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'МГТУ им. Н. Э. Баумана',
    },
    {
      '@type': 'EducationalOrganization',
      name: 'Школа 21',
    },
  ],
  homeLocation: {
    '@type': 'City',
    name: lang === 'ru' ? 'Санкт-Петербург' : 'Saint Petersburg',
  },
  sameAs: [
    'https://x.com/vixkosla',
    'https://www.upwork.com/freelancers/askerovt',
    'https://t.me/vixkosla',
    'https://github.com/vixkosla',
  ],
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SonicXBoy',
  alternateName: 'SonicXBoy WebGL Developer',
  url: `${SITE}/`,
}

const sourceSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'SonicXBoy Portfolio',
  description:
    'Open-source Astro, React Three Fiber and Three.js portfolio with authored WebGL choreography, responsive camera direction and an agent-readable source kit.',
  codeRepository: SOURCE_REPOSITORY,
  url: `${SITE}/`,
  license: `${SOURCE_REPOSITORY}/blob/main/LICENSE`,
  programmingLanguage: ['TypeScript', 'JavaScript', 'GLSL', 'CSS', 'Astro'],
  runtimePlatform: 'Web browser',
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#050907" />
    <meta name="repository" content={SOURCE_REPOSITORY} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/json"
      href="/source-kit.json"
      title="SonicXBoy source kit"
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={`${SITE}/`} />
    <link rel="alternate" hreflang="en" href={`${SITE}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'ru' ? 'en_US' : 'ru_RU'}
    />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SonicXBoy — WebGL Developer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@vixkosla" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(sourceSchema)} />
    <script is:inline>
      const viewportLabParams = new URLSearchParams(window.location.search)
      if (
        viewportLabParams.get('viewport-lab') === 'grid' &&
        viewportLabParams.has('plasma-preview')
      ) {
        document.documentElement.dataset.viewportLabGrid = ''
        if (viewportLabParams.get('plasma-preview') === 'card') {
          document.documentElement.dataset.viewportLabCard = ''
        }
      }
    </script>
    <style>
      /* :global — the reactor card is React-rendered (no astro-cid),
         a scoped reset never reaches it. */
      :global(*),
      :global(*::before),
      :global(*::after) {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --ink: #e8f5ee;
        --ink-dim: rgba(218, 238, 229, 0.72);
        --reactor: #18d383;
        --reactor-mint: #6cf3b3;
        --emerald: var(--reactor);
        --emerald-dim: rgba(24, 211, 131, 0.32);
        --bg: #050907;
        --card-h: clamp(300px, 27.5vh, 360px);
        --font-display: 'Tektur Variable', system-ui, sans-serif;
        --font-vyaz: 'Ponomar', 'Old Standard TT', Georgia, serif;
        --font-book: 'Old Standard TT', Georgia, 'Times New Roman', serif;
        --font-body: 'Onest Variable', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace;
        --safe-top: env(safe-area-inset-top, 0px);
        --safe-right: env(safe-area-inset-right, 0px);
        --safe-bottom: env(safe-area-inset-bottom, 0px);
        --safe-left: env(safe-area-inset-left, 0px);
      }

      html,
      body {
        width: 100%;
        height: 100%;
        max-width: 100%;
        min-width: 0;
      }

      body {
        font-family: var(--font-body);
        color: var(--ink);
        background: var(--bg);
        overflow-x: hidden;
        overflow-x: clip;
      }

      :global(body.reactor-card-visible) {
        overflow: hidden;
      }

      a:focus-visible {
        outline: 2px solid var(--emerald);
        outline-offset: 3px;
      }

      :global(.hero-scene) {
        position: fixed;
        inset: 0;
        z-index: 0;
        width: 100%;
        max-width: 100%;
      }

      /* Wide desktop viewports leave real empty space around the object.
         A screen-blended nebula fills it without competing with the scene:
         additive blending means it barely registers over anything already
         bright (the plasma core, lit cube faces, the card) and only really
         shows in the near-black gaps, so the object and text stay the read.
         Kept out of the DOM's z-index=1 content layer entirely; it sits
         between the canvas and the text, at the same stacking level as the
         canvas so plain DOM order decides paint order. */
      @media (min-width: 961px) {
        .hero-nebula {
          position: fixed;
          inset: 0;
          z-index: 0;
          pointer-events: none;
          mix-blend-mode: screen;
          background:
            radial-gradient(
              ellipse 62vw 58vh at 90% 6%,
              rgba(226, 46, 58, 0.22),
              transparent 62%
            ),
            radial-gradient(
              ellipse 48vw 62vh at 99% 64%,
              rgba(178, 33, 45, 0.16),
              transparent 60%
            ),
            radial-gradient(
              ellipse 42vw 42vh at 2% 92%,
              rgba(120, 24, 34, 0.1),
              transparent 65%
            );
        }
      }

      /* ── Wordmark ─────────────────────────────────────────── */

      .brand {
        position: fixed;
        top: 1.6rem;
        left: clamp(1.5rem, 8vw, 9rem);
        z-index: 2;
        font-size: 0.72rem;
      }

      /* ── Language switcher ────────────────────────────────── */

      .lang {
        position: fixed;
        top: 1.9rem;
        right: clamp(1.5rem, 8vw, 9rem);
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-family: var(--font-mono);
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.12em;
      }

      .lang__link {
        color: var(--ink-dim);
        text-decoration: none;
        padding: 0.2rem 0.1rem;
        pointer-events: auto;
        transition: color 0.2s ease;
      }

      .lang__link:hover {
        color: var(--ink);
      }

      .lang__link.is-active {
        color: var(--emerald);
      }

      .lang__sep {
        color: rgba(232, 245, 238, 0.25);
      }

      /* ── Reactor card (arrives from the 3D scene) ─────────── */

      :global(.reactor-card) {
        --card-ivory: #fffdf4;
        --card-paper: #f4f3e7;
        --card-ink: #123f2b;
        --card-ink-soft: rgba(18, 63, 43, 0.82);
        --card-green: #1a7a52;
        --card-green-deep: #0a4530;
        --card-green-bright: #2f9e6e;
        --card-gold: #c7a247;
        --card-gold-light: #ead99b;
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 3;
        width: 100vw;
        min-height: var(--card-h);
        display: flex;
        flex-direction: column;
        padding:
          1.4rem clamp(1.5rem, 8vw, 9rem)
          1.25rem;
        overflow-x: hidden;
        overflow-y: auto;
        isolation: isolate;
        color: var(--card-ink);
        background:
          radial-gradient(circle at 7% 118%, rgba(33, 112, 72, 0.24), transparent 36%),
          radial-gradient(circle at 93% -24%, rgba(199, 162, 71, 0.25), transparent 31%),
          linear-gradient(
            116deg,
            rgba(255, 255, 252, 0.985) 0%,
            rgba(247, 246, 235, 0.97) 47%,
            rgba(231, 241, 228, 0.965) 100%
          ),
          var(--card-paper);
        border: 1px solid rgba(175, 136, 39, 0.78);
        border-right: 0;
        border-bottom: 0;
        border-left: 0;
        border-radius: 0;
        box-shadow:
          0 -10px 48px rgba(2, 31, 19, 0.24),
          0 24px 70px rgba(0, 0, 0, 0.28),
          inset 0 1px 0 rgba(255, 255, 255, 0.96),
          inset 0 0 42px rgba(55, 133, 84, 0.09);
        backdrop-filter: blur(18px) saturate(112%);
        opacity: 0;
        filter: blur(7px);
        transform: translate3d(-100%, -2.8rem, 0) scale(0.18, 0.38);
        transform-origin: left center;
        transition:
          transform 1.16s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.18s ease-out,
          filter 0.72s ease-out;
        pointer-events: none;
        will-change: transform, opacity, filter;
        scrollbar-width: thin;
        scrollbar-color: rgba(155, 119, 30, 0.62) transparent;
      }

      :global(.reactor-card::-webkit-scrollbar) {
        width: 3px;
      }

      :global(.reactor-card::-webkit-scrollbar-thumb) {
        background: rgba(155, 119, 30, 0.62);
      }

      :global(.reactor-card::after) {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          linear-gradient(112deg, rgba(255, 255, 255, 0.48), transparent 35%),
          linear-gradient(90deg, rgba(199, 162, 71, 0.16), transparent 34%),
          radial-gradient(circle at 92% -20%, rgba(26, 122, 82, 0.13), transparent 30%),
          radial-gradient(
              circle at 9px 9px,
              rgba(161, 123, 30, 0.14) 0 0.7px,
              transparent 1.05px
            )
            0 0 / 18px 18px,
          radial-gradient(
              circle at 31px 23px,
              rgba(199, 153, 48, 0.13) 0 1.15px,
              transparent 1.55px
            )
            0 0 / 53px 47px,
          repeating-linear-gradient(
            90deg,
            transparent 0,
            transparent 71px,
            rgba(20, 91, 59, 0.075) 71px,
            rgba(20, 91, 59, 0.075) 72px
          ),
          repeating-linear-gradient(
            0deg,
            transparent 0,
            transparent 71px,
            rgba(20, 91, 59, 0.065) 71px,
            rgba(20, 91, 59, 0.065) 72px
          ),
          repeating-linear-gradient(
            90deg,
            transparent 0,
            transparent 17px,
            rgba(164, 128, 39, 0.038) 17px,
            rgba(164, 128, 39, 0.038) 18px
          ),
          repeating-linear-gradient(
            0deg,
            transparent 0,
            transparent 17px,
            rgba(164, 128, 39, 0.034) 17px,
            rgba(164, 128, 39, 0.034) 18px
          );
        opacity: 0;
        clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
      }

      :global(.reactor-card.is-visible::after) {
        animation: reactor-board-etch 1.85s cubic-bezier(0.16, 1, 0.3, 1) 0.52s both;
      }

      :global(.reactor-card__circuit) {
        position: absolute;
        inset: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        overflow: visible;
        pointer-events: none;
      }

      :global(.reactor-card__circuit-frame) {
        fill: none;
        stroke: rgba(146, 106, 20, 0.28);
        stroke-width: 0.7;
        stroke-dasharray: 2 11;
        vector-effect: non-scaling-stroke;
      }

      :global(.reactor-card__circuit-grooves path) {
        fill: none;
        stroke: rgba(5, 61, 38, 0.22);
        stroke-width: 3.1;
        stroke-linecap: square;
        stroke-linejoin: miter;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        vector-effect: non-scaling-stroke;
        opacity: 0;
      }

      :global(.reactor-card__circuit-metal path) {
        fill: none;
        stroke: rgba(157, 118, 27, 0.58);
        stroke-width: 0.86;
        stroke-linecap: square;
        stroke-linejoin: miter;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        vector-effect: non-scaling-stroke;
        filter: drop-shadow(0 0 2px rgba(255, 255, 248, 0.72));
        opacity: 0;
      }

      :global(.reactor-card__circuit-metal path:nth-child(4n + 2)) {
        stroke: rgba(28, 112, 72, 0.42);
        stroke-width: 0.66;
      }

      :global(.reactor-card__circuit-grooves path:nth-child(3n)) {
        stroke-width: 2.5;
      }

      /* Birch-bark lenticel marks: short dark horizontal slashes between
         the circuit rows. The card surface is a pale warm paper, so these
         should be a dark green-brown (like real birch lenticels), slightly
         translucent with a soft drop shadow so they read as part of the
         material texture rather than drawn-on ink. */
      :global(.reactor-card__bark-marks) {
        filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.15));
      }

      :global(.reactor-card__bark-marks path) {
        fill: none;
        stroke: rgba(7, 30, 18, 0.72);
        stroke-width: 3.2;
        stroke-linecap: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        vector-effect: non-scaling-stroke;
        opacity: 0;
      }

      :global(.reactor-card__bark-marks path:nth-child(3n)) {
        stroke-width: 2.2;
        stroke: rgba(7, 30, 18, 0.52);
      }

      :global(.reactor-card__bark-marks path:nth-child(5n + 1)) {
        stroke-width: 4;
        stroke: rgba(5, 20, 12, 0.82);
      }

      :global(.reactor-card__bark-marks path:nth-child(7n + 3)) {
        stroke-width: 1.8;
        stroke: rgba(7, 30, 18, 0.38);
        stroke-dasharray: 0.7 0.3;
      }

      :global(.reactor-card.is-visible .reactor-card__bark-marks path) {
        animation: reactor-bark-appear 0.7s ease-out
          calc(0.6s + var(--bark-delay, 0s)) both;
      }

      :global(.reactor-card__circuit-pads rect) {
        fill: rgba(255, 253, 244, 0.94);
        stroke: rgba(19, 100, 63, 0.58);
        stroke-width: 0.72;
        vector-effect: non-scaling-stroke;
        opacity: 0;
      }

      :global(.reactor-card.is-visible .reactor-card__circuit-metal path) {
        animation: reactor-circuit-draw 1.05s cubic-bezier(0.16, 1, 0.3, 1)
          calc(0.14s + var(--circuit-delay, 0s)) both;
      }

      :global(.reactor-card.is-visible .reactor-card__circuit-grooves path) {
        animation: reactor-circuit-settle 0.9s cubic-bezier(0.16, 1, 0.3, 1)
          calc(0.5s + var(--circuit-delay, 0s)) both;
      }

      :global(.reactor-card.is-visible .reactor-card__circuit-pads rect) {
        animation: reactor-circuit-pad 0.42s ease-out
          calc(0.72s + var(--pad-delay, 0s)) both;
      }

      :global(.reactor-card.is-visible) {
        opacity: 1;
        filter: blur(0);
        transform: translate3d(0, 0, 0) scale(1);
        animation: reactor-card-arrival 1.8s ease-out both;
        pointer-events: auto;
      }

      /* Vivaldi can suspend CSS transitions in offscreen extension iframes.
         The grid preview is an explicit frozen inspection mode, so resolve
         the card directly to its authored final frame there. */
      :global(html[data-viewport-lab-grid] .reactor-card) {
        transition: none;
      }

      :global(html[data-viewport-lab-grid] .reactor-card.is-visible) {
        animation: none;
      }

      /* The extension may suspend an offscreen WebGL context before r3f's
         first frame. The final card is SSR markup, so card inspection stays
         deterministic even when a canvas never receives that reveal frame. */
      :global(html[data-viewport-lab-card] .reactor-card) {
        opacity: 1;
        filter: blur(0);
        transform: translate3d(0, 0, 0) scale(1);
        pointer-events: auto;
      }

      :global(html[data-viewport-lab-card] .reactor-card::after) {
        animation: none;
        opacity: 0.82;
        clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      }

      :global(html[data-viewport-lab-card] .reactor-card__circuit-grooves path),
      :global(html[data-viewport-lab-card] .reactor-card__bark-marks path) {
        animation: none;
        opacity: 0.82;
        stroke-dashoffset: 0;
      }

      :global(html[data-viewport-lab-card] .reactor-card__circuit-metal path),
      :global(html[data-viewport-lab-card] .reactor-card__circuit-pads rect) {
        animation: none;
        opacity: 1;
        stroke-dashoffset: 0;
      }

      :global(html[data-viewport-lab-card] .reactor-card__actions) {
        visibility: visible;
      }

      :global(.reactor-card__content) {
        position: relative;
        z-index: 2;
        display: flex;
        flex: 1;
        flex-direction: column;
        width: 100%;
        min-width: 0;
      }

      :global(.reactor-card__signal) {
        position: absolute;
        inset: 0 auto 0 0;
        z-index: 3;
        width: 3px;
        color: var(--card-gold);
        background: currentColor;
        box-shadow:
          0 0 12px currentColor,
          0 0 34px currentColor;
      }

      :global(.reactor-card.is-visible .reactor-card__signal) {
        animation: reactor-signal-settle 2.4s ease-out both;
      }

      :global(.reactor-card__signal::after) {
        content: '';
        position: absolute;
        left: 8px;
        top: 15px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 14px currentColor;
        animation: reactor-signal 0.8s ease-in-out 3;
      }

      :global(.reactor-card__meta) {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.72rem;
        color: rgba(17, 110, 74, 0.78);
        font: 600 0.66rem/1.2 var(--font-mono);
        letter-spacing: 0.14em;
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.94);
      }

      @supports ((background-clip: text) or (-webkit-background-clip: text)) {
        :global(.reactor-card__meta) {
          color: transparent;
          background: linear-gradient(
            92deg,
            #0c5c3d 0%,
            #2f9e6e 26%,
            #b28a25 52%,
            #1a7a52 78%,
            #0a4530 100%
          );
          background-clip: text;
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
        }
      }

      :global(.reactor-card h2) {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 0.11em;
        isolation: isolate;
        margin: 0 0 0.85rem;
        color: var(--card-green-deep);
        font-family: var(--font-vyaz);
        font-size: clamp(1.28rem, 1.7vw, 1.72rem);
        font-weight: 400;
        line-height: 1.02;
        letter-spacing: 0.008em;
        font-variant-ligatures: common-ligatures discretionary-ligatures historical-ligatures;
        font-feature-settings: 'liga' 1, 'dlig' 1, 'hlig' 1, 'calt' 1;
        text-wrap: balance;
        text-shadow:
          0 1px 0 rgba(255, 255, 255, 0.96),
          0 0 12px rgba(199, 162, 71, 0.22);
      }

      :global(.reactor-card h2::after) {
        content: '';
        position: absolute;
        right: 0;
        bottom: -0.42rem;
        left: 0;
        height: 2px;
        opacity: 0.82;
        background: linear-gradient(
          90deg,
          #0c5c3d 0 18%,
          #fffdf4 18% 29%,
          #c7a247 29% 52%,
          #2f9e6e 52% 72%,
          #ead99b 72% 88%,
          transparent 97%
        );
        box-shadow:
          0 1px 0 rgba(8, 69, 48, 0.3),
          0 0 8px rgba(199, 162, 71, 0.38),
          0 0 14px rgba(26, 122, 82, 0.18);
        clip-path: polygon(0 0, 100% 0, 97% 100%, 1.2% 100%);
      }

      :global(.reactor-card__heading-initial) {
        position: relative;
        z-index: 0;
        flex: 0 0 auto;
        display: inline-grid;
        place-items: center;
        min-width: 0.8em;
        margin: -0.1em 0 -0.05em;
        padding: 0.075em 0.115em 0.035em;
        color: #fffef6;
        font-size: 1.62em;
        line-height: 0.78;
        -webkit-text-stroke: 0.02em rgba(5, 76, 47, 0.96);
        text-shadow:
          -0.045em 0.035em 0 #c39b3d,
          0.045em 0.04em 0 #1a7a52,
          0 0 0.24em rgba(255, 251, 226, 0.94),
          0 0.08em 0.2em rgba(4, 58, 37, 0.34);
      }

      :global(.reactor-card__heading-initial::before) {
        content: '';
        position: absolute;
        inset: -0.08em -0.035em;
        z-index: -1;
        opacity: 0.94;
        background:
          radial-gradient(circle at 22% 24%, #fffdf2 0 5%, transparent 6%),
          radial-gradient(circle at 78% 75%, #e6cf82 0 5%, transparent 6%),
          conic-gradient(
            from 24deg,
            rgba(10, 92, 61, 0.96),
            rgba(246, 244, 225, 0.98),
            rgba(26, 122, 82, 0.94),
            rgba(204, 164, 65, 0.98),
            rgba(10, 92, 61, 0.96)
          );
        box-shadow:
          inset 0 0 0 1px rgba(230, 207, 130, 0.96),
          inset 0 0 0.24em rgba(255, 255, 248, 0.62),
          0 0 0.3em rgba(18, 104, 65, 0.28),
          0 0 0.44em rgba(199, 162, 71, 0.22);
        clip-path: polygon(10% 0, 89% 6%, 100% 84%, 83% 100%, 4% 92%, 0 15%);
      }

      :global(.reactor-card__heading-initial::after) {
        content: '';
        position: absolute;
        top: -0.13em;
        right: -0.12em;
        width: 0.16em;
        height: 0.16em;
        background: #d1ad53;
        box-shadow:
          -0.21em 0.04em 0 #1a7a52,
          -0.05em 0.23em 0 #fffdf4,
          -0.23em 0.24em 0 #6fb98c;
        transform: rotate(45deg);
      }

      :global(.reactor-card__heading-text) {
        min-width: 0;
        color: var(--card-green-deep);
        font: inherit;
        line-height: inherit;
        text-shadow:
          -0.018em 0 0 rgba(178, 137, 37, 0.58),
          0.018em 0.02em 0 rgba(29, 112, 70, 0.42),
          0 0 0.26em rgba(255, 255, 248, 0.92),
          0 0.07em 0.22em rgba(8, 69, 48, 0.22);
      }

      @supports ((background-clip: text) or (-webkit-background-clip: text)) {
        :global(.reactor-card__heading-text) {
          color: transparent;
          background: linear-gradient(
            96deg,
            #0c5c3d 0%,
            #2f9e6e 17%,
            #fffdf4 31%,
            #c39c3f 45%,
            #f4ebca 58%,
            #2f9e6e 72%,
            #d7bb69 86%,
            #0c5c3d 100%
          );
          background-size: 145% 100%;
          background-clip: text;
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          -webkit-text-stroke: 0.006em rgba(7, 67, 43, 0.28);
        }
      }

      /* A Church-Slavonic display hand leads into a readable old-style
         book face. The three text leaves still share one top rule and
         retain the original tablet proportions without shouting in caps. */
      :global(.reactor-card__body) {
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: 0.86fr 1.16fr 0.98fr;
        gap: clamp(1.5rem, 2.6vw, 3.25rem);
        align-items: stretch;
        width: 100%;
      }

      :global(.reactor-card p) {
        position: relative;
        z-index: 1;
        color: var(--card-ink-soft);
        border-top: 1px solid rgba(163, 124, 30, 0.48);
        padding-top: 0.72rem;
        background: linear-gradient(
          180deg,
          rgba(255, 255, 250, 0.56),
          rgba(224, 238, 223, 0.28)
        );
        box-shadow: inset 0 -1px 0 rgba(36, 112, 72, 0.13);
        font-family: var(--font-book);
        font-size: var(--card-copy-fit, clamp(0.82rem, 0.8vw, 0.94rem));
        font-weight: 400;
        line-height: 1.38;
        letter-spacing: 0.012em;
        font-variant-ligatures: common-ligatures discretionary-ligatures;
        text-align: justify;
        hyphens: auto;
        overflow-wrap: break-word;
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.96);
      }

      /* Per-leaf ink variation: each column keeps the same green-on-paper
         readability but shifts its weight along the resin → gold spectrum,
         so the three leaves read as separate documents instead of one
         flat block. */
      :global(.reactor-card__body > :nth-child(1) p) {
        color: rgba(10, 74, 48, 0.88);
        border-top-color: rgba(26, 122, 82, 0.5);
      }

      :global(.reactor-card__body > :nth-child(2) p) {
        color: rgba(93, 71, 14, 0.82);
        border-top-color: rgba(199, 162, 71, 0.55);
      }

      :global(.reactor-card__body > :nth-child(3) p) {
        color: rgba(18, 63, 43, 0.8);
        border-top-color: rgba(47, 158, 110, 0.5);
      }

      /* Desktop (>960px): the card body is typeset like a Slavonic
         manuscript — Ponomar capitals over an Old Standard book hand.
         On mobile the dense pager cards keep the plainer treatment,
         which already reads well at small sizes. */
      @media (min-width: 961px) {
        :global(.reactor-card__body p) {
          font-family: var(--font-vyaz);
          font-size: calc(var(--card-copy-fit, clamp(0.82rem, 0.8vw, 0.94rem)) * 1.06);
          line-height: 1.44;
          letter-spacing: 0.014em;
          text-align: left;
          hyphens: none;
        }

        :global(.reactor-card__body p::before) {
          content: attr(data-page);
          display: block;
          margin-bottom: 0.5rem;
          color: rgba(178, 48, 58, 0.88);
          font: 400 0.78rem/1 var(--font-vyaz);
          letter-spacing: 0.1em;
        }

        :global(.reactor-card__body p::first-letter) {
          color: #b2303a;
          font-family: var(--font-vyaz);
          font-size: 1.62em;
          line-height: 0.86;
          padding-right: 0.045em;
        }
      }

      /* Accent words from bracketed [tokens] get visible decoration on all
         sizes - not only desktop. Simple CSS tools: background highlight,
         text outline through text-shadow, a colored underline via ::before,
         and a small diacritic glyph via ::after. */
      :global(.reactor-card__accent) {
        position: relative;
        font-style: normal;
        font-weight: 600;
        color: #1a3530;
        padding: 0.04em 0.12em 0.06em;
        border-radius: 0.12em;
        background: linear-gradient(
          135deg,
          rgba(199, 162, 71, 0.18),
          rgba(199, 162, 71, 0.06) 70%
        );
        box-shadow:
          inset 0 0 0 0.5px rgba(199, 162, 71, 0.35),
          0 1px 0 rgba(199, 162, 71, 0.15);
        text-shadow:
          0 0.5px 0 rgba(255, 253, 244, 0.9),
          0 1.5px 3px rgba(5, 30, 20, 0.18);
      }

      :global(.reactor-card__accent::before) {
        content: '';
        position: absolute;
        left: 0.08em;
        right: 0.08em;
        bottom: -0.1em;
        height: 2px;
        border-radius: 1px;
        background: linear-gradient(
          90deg,
          transparent 5%,
          rgba(199, 162, 71, 0.6),
          transparent 95%
        );
      }

      :global(.reactor-card__accent::after) {
        content: '✦';
        position: absolute;
        top: -0.6em;
        right: -0.15em;
        color: rgba(199, 162, 71, 0.55);
        font-size: 0.55em;
        line-height: 1;
        text-shadow: 0 0.5px 1px rgba(0, 0, 0, 0.3);
      }

      /* Second-column accents get a different glyph and cooler tone */
      :global(.reactor-card__body > :nth-child(2) .reactor-card__accent) {
        background: linear-gradient(
          135deg,
          rgba(47, 158, 110, 0.15),
          rgba(47, 158, 110, 0.04) 70%
        );
        box-shadow:
          inset 0 0 0 0.5px rgba(47, 158, 110, 0.3),
          0 1px 0 rgba(47, 158, 110, 0.12);
      }

      :global(.reactor-card__body > :nth-child(2) .reactor-card__accent::after) {
        content: '◆';
        color: rgba(47, 158, 110, 0.5);
      }

      /* Third-column: warmer, like colophon marks */
      :global(.reactor-card__body > :nth-child(3) .reactor-card__accent) {
        background: linear-gradient(
          135deg,
          rgba(178, 48, 58, 0.12),
          rgba(178, 48, 58, 0.03) 70%
        );
        box-shadow:
          inset 0 0 0 0.5px rgba(178, 48, 58, 0.25),
          0 1px 0 rgba(178, 48, 58, 0.1);
      }

      :global(.reactor-card__body > :nth-child(3) .reactor-card__accent::after) {
        content: '❖';
        color: rgba(178, 48, 58, 0.42);
      }

      /* On mobile where paragraphs don't overflow:hidden, keep accents but
         smaller - they should never break line-height flow. On desktop the
         manuscript treatment keeps larger accents. */
      @media (max-width: 960px) {
        :global(.reactor-card__accent) {
          font-weight: 500;
          padding: 0.02em 0.08em 0.04em;
          background: transparent;
          box-shadow: none;
          border-radius: 0;
          color: #0f4a38;
          text-shadow: none;
        }
        :global(.reactor-card__accent::before) {
          height: 1.5px;
          bottom: -0.06em;
          background: linear-gradient(
            90deg,
            transparent 5%,
            rgba(199, 162, 71, 0.4),
            transparent 95%
          );
        }
        :global(.reactor-card__accent::after) {
          display: none;
        }
      }

      :global(.reactor-card__body[data-copy-fit] p) {
        overflow: hidden;
      }

      /* Desktop manuscript mode needs the accent glyphs (⸙/◈) visible - they
         sit above the text line via ::after's negative top offset and would
         be clipped by overflow:hidden. The copy-fit measurement already found
         a font size that fits the container, so the overflow guard is
         redundant on desktop. */
      @media (min-width: 961px) {
        :global(.reactor-card__body[data-copy-fit] p) {
          overflow: visible;
        }
      }

      :global(.reactor-card p + p) {
        margin-top: 0;
      }

      :global(.reactor-card__stack) {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 0.85rem;
        margin-top: 1rem;
        color: var(--card-green);
        font: 600 0.65rem/1 var(--font-mono);
        letter-spacing: 0.12em;
      }

      @supports ((background-clip: text) or (-webkit-background-clip: text)) {
        :global(.reactor-card__stack) {
          color: transparent;
          background: linear-gradient(
            88deg,
            #0a4530 0%,
            #1a7a52 22%,
            #c7a247 48%,
            #2f9e6e 74%,
            #0a4530 100%
          );
          background-clip: text;
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
        }
      }

      @keyframes reactor-card-arrival {
        0%, 18% {
          border-color: rgba(199, 162, 71, 0.92);
          box-shadow:
            0 0 30px rgba(199, 162, 71, 0.38),
            0 24px 70px rgba(0, 0, 0, 0.28),
            inset 0 1px 0 rgba(255, 255, 255, 0.96);
        }
        100% {
          border-color: rgba(25, 103, 66, 0.58);
          box-shadow:
            0 -10px 48px rgba(2, 31, 19, 0.24),
            0 24px 70px rgba(0, 0, 0, 0.28),
            inset 0 1px 0 rgba(255, 255, 255, 0.96),
            inset 0 0 42px rgba(55, 133, 84, 0.09);
        }
      }

      @keyframes reactor-signal {
        0%, 100% { opacity: 0.36; transform: scale(0.82); }
        50% { opacity: 1; transform: scale(1.18); }
      }

      @keyframes reactor-signal-settle {
        0%, 64% { color: var(--card-gold); }
        100% { color: var(--card-green); }
      }

      @keyframes reactor-board-etch {
        0% {
          opacity: 0;
          clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
        }
        42% {
          opacity: 0.72;
          clip-path: polygon(0 0, 58% 0, 40% 100%, 0 100%);
        }
        100% {
          opacity: 0.82;
          clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
        }
      }

      @keyframes reactor-circuit-draw {
        0% {
          opacity: 0;
          stroke-dashoffset: 1;
        }
        28% { opacity: 1; }
        100% {
          opacity: 1;
          stroke-dashoffset: 0;
        }
      }

      @keyframes reactor-circuit-settle {
        0% {
          opacity: 0;
          stroke-dashoffset: 1;
        }
        100% {
          opacity: 0.82;
          stroke-dashoffset: 0;
        }
      }

      @keyframes reactor-bark-appear {
        0% {
          opacity: 0;
          stroke-dashoffset: 1;
        }
        60% {
          opacity: 0.9;
          stroke-dashoffset: 0.15;
        }
        100% {
          opacity: 1;
          stroke-dashoffset: 0;
        }
      }

      @keyframes reactor-circuit-pad {
        0% { opacity: 0; }
        60% { opacity: 0.72; }
        100% { opacity: 1; }
      }

      /* ── Hero overlay ─────────────────────────────────────── */

      main {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        text-align: left;
        /* Top padding keeps the eyebrow clear of the fixed brand badge */
        padding: 8.5rem clamp(1.5rem, 8vw, 9rem) 2rem;
        pointer-events: none;
        transition: padding-bottom 1.1s cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* Make room for the arriving card instead of hiding content */
      :global(body.reactor-card-visible) main {
        padding-bottom: calc(var(--card-h) + 2.5rem);
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--emerald);
        margin-bottom: 1.1rem;
      }

      h1 {
        /* Monoton and Faster One are single-weight: keep 400 so the
           line-art glyphs don't get faux-bolded. */
        font-family: 'Faster One', var(--font-display);
        /* vw-clamp for width, vh cap so the two-line block doesn't
           swallow shorter screens (1080p) while 2K keeps full size */
        font-size: min(clamp(2.3rem, 8.6vw, 9rem), 11vh);
        font-weight: 400;
        line-height: 1;
        letter-spacing: 0;
        text-transform: uppercase;
        margin-bottom: 1.6rem;
      }

      .headline__solid {
        font-family: 'Monoton', 'Faster One', var(--font-display);
        /* 1.6em width-matches the 5-glyph Monoton line to the
           9-glyph Faster One line below it. */
        font-size: 1.6em;
        color: var(--reactor);
        background: linear-gradient(
          165deg,
          #eafff5 0%,
          #78aa94 16%,
          #173c2d 35%,
          #071b13 48%,
          #129d65 62%,
          #74edb5 79%,
          #0b5036 100%
        );
        background-size: 100% 128%;
        background-position: 50% 44%;
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 0 0.18em rgba(24, 211, 131, 0.13));
      }

      :global(body[data-material-baseline]) .headline__solid {
        color: var(--ink);
        background: none;
        -webkit-text-fill-color: currentColor;
        filter: none;
      }

      .headline__solid,
      .headline__outline {
        display: block;
        position: relative;
        width: max-content;
        isolation: isolate;
      }

      .headline__outline {
        color: var(--emerald);
      }

      .headline__outline::after {
        content: attr(data-text);
        position: absolute;
        inset: 0;
        z-index: 1;
        color: transparent;
        background: linear-gradient(
          108deg,
          transparent 0 29%,
          var(--orbit-wave-glow) 36%,
          var(--orbit-wave-color) 44%,
          var(--orbit-wave-hot) 51%,
          var(--orbit-wave-color) 58%,
          var(--orbit-wave-glow) 66%,
          transparent 73% 100%
        );
        background-size: 214% 214%;
        background-position: -58% 148%;
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        -webkit-text-stroke: 0;
        opacity: 0;
        filter: drop-shadow(0 0 0 transparent);
        pointer-events: none;
        will-change: background-position, opacity, filter;
      }

      :global(body[data-orbit-title-wave='outer-approach']) .headline__outline::after {
        --orbit-wave-color: #38e8ad;
        --orbit-wave-hot: #effff9;
        --orbit-wave-glow: rgba(56, 232, 173, 0.34);
        animation: orbit-title-wave-approach 2.28s cubic-bezier(0.24, 0, 0.18, 1) both;
      }

      :global(body[data-orbit-title-wave='outer-near']) .headline__outline::after {
        --orbit-wave-color: #1fcde0;
        --orbit-wave-hot: #e8fdff;
        --orbit-wave-glow: rgba(31, 205, 224, 0.36);
        animation: orbit-title-wave-near 2.36s cubic-bezier(0.24, 0, 0.18, 1) both;
      }

      :global(body[data-orbit-title-wave='outer-return']) .headline__outline::after {
        --orbit-wave-color: #4167ff;
        --orbit-wave-hot: #e7edff;
        --orbit-wave-glow: rgba(65, 103, 255, 0.32);
        animation: orbit-title-wave-return 1.58s cubic-bezier(0.24, 0, 0.18, 1) both;
      }

      @keyframes orbit-title-wave-approach {
        0% { opacity: 0; background-position: -62% 152%; }
        10% { opacity: 1; }
        80% { opacity: 1; }
        100% {
          opacity: 0;
          background-position: 148% -50%;
          filter: drop-shadow(0 0 18px rgba(56, 232, 173, 0.38));
        }
      }

      @keyframes orbit-title-wave-near {
        0% { opacity: 0; background-position: -62% 152%; }
        10% { opacity: 1; }
        80% { opacity: 1; }
        100% {
          opacity: 0;
          background-position: 148% -50%;
          filter: drop-shadow(0 0 19px rgba(31, 205, 224, 0.4));
        }
      }

      @keyframes orbit-title-wave-return {
        0% { opacity: 0; background-position: -62% 152%; }
        10% { opacity: 1; }
        68% { opacity: 1; }
        100% {
          opacity: 0;
          background-position: 148% -50%;
          filter: drop-shadow(0 0 20px rgba(65, 103, 255, 0.4));
        }
      }

      .subtitle {
        max-width: 46ch;
        font-size: 1.08rem;
        line-height: 1.6;
        color: var(--ink-dim);
      }

      .tech-stack {
        margin-top: 1.9rem;
        display: flex;
        gap: 0.55rem;
        flex-wrap: wrap;
        max-width: 40rem;
      }

      .tech-badge {
        padding: 0.38rem 0.7rem;
        background: rgba(24, 211, 131, 0.08);
        border: 1px solid var(--emerald-dim);
        border-radius: 2px;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--emerald);
      }

      /* ── Air-support oval ─────────────────────────────────────
         One ellipse line repeated in vertical storeys, so the lanes
         stand as walls of an elliptical cylinder; crossings emerge
         only in the viewer's projection. Each pulse fades in, glides
         one lap with ease-in-out, then fades out — the figure reads
         as loosely filled, appearing and disappearing in places.
         Width matches the measured headline width (75vh on desktop);
         the compressed wall is raised so its near rim wraps the title
         foot, subtitle, and badges instead of floating below them —
         their copy occludes the far arcs while the near arcs (the
         mirrored svg painted after the text) cross in front. Hidden
         until the first orbit title wave ignites it; fades with the
         card. */
      .hero-oval {
        position: absolute;
        left: clamp(1.5rem, 8vw, 9rem);
        bottom: clamp(4rem, 22vh, 14rem);
        width: min(66rem, 75vh);
        aspect-ratio: 1200 / 400;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.32s ease-out;
      }

      /* Only the half beyond the copy plane is optically defocused. The
         viewer-side wall stays crisp, while the subtitle and stack sit in
         a clean focal plane against this softer, lower-contrast depth. */
      .hero-oval--back {
        filter: blur(3.2px) saturate(0.72) brightness(0.76);
      }

      /* Each wall grows from its base before the extruded panels light up.
         Outer lanes lead inner lanes; the inline delays then continue
         the wave from the far svg into the near svg. */
      .oval-lane {
        opacity: 0;
        transform-box: fill-box;
        transform-origin: 50% 100%;
        transform: translateY(7px) scaleY(0.18);
        transition:
          opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1) var(--lane-exit),
          transform 0.94s cubic-bezier(0.16, 1, 0.3, 1) var(--lane-exit);
      }

      .oval-panels {
        opacity: 0;
        transform-box: fill-box;
        transform-origin: 50% 50%;
        transform: translateY(2px) scaleX(0.9);
        transition:
          opacity 0.5s ease-out var(--panel-exit),
          transform 0.72s cubic-bezier(0.16, 1, 0.3, 1) var(--panel-exit);
      }

      :global(body[data-oval-on]:not([data-oval-leaving]):not(.reactor-card-visible)) .hero-oval {
        opacity: var(--oval-visibility, 1);
      }

      :global(body[data-oval-on]:not([data-oval-leaving]):not(.reactor-card-visible)) .oval-lane {
        opacity: 1;
        transform: translateY(0) scaleY(1);
        transition-delay: var(--lane-enter);
      }

      :global(body[data-oval-on]:not([data-oval-leaving]):not(.reactor-card-visible)) .oval-panels {
        opacity: 1;
        transform: translateY(0) scaleX(1);
        transition-delay: var(--panel-enter);
      }

      /* The card gets a 1.25 s lead signal from HeroScene. The near/inner
         panels release first, then the walls fold back toward the base;
         the parent fade only joins after that reverse sequence is legible. */
      :global(body[data-oval-leaving]) .hero-oval,
      :global(body.reactor-card-visible) .hero-oval {
        opacity: 0;
        transition-duration: 0.55s;
        transition-delay: 0.7s;
      }

      :global(body[data-oval-leaving]) .oval-lane,
      :global(body.reactor-card-visible) .oval-lane {
        opacity: 0;
        transform: translateY(4px) scaleY(0.28);
        transition-duration: 0.42s, 0.62s;
        transition-delay: var(--lane-exit);
      }

      :global(body[data-oval-leaving]) .oval-panels,
      :global(body.reactor-card-visible) .oval-panels {
        opacity: 0;
        transform: translateY(1px) scaleX(0.94);
        transition-duration: 0.3s, 0.45s;
        transition-delay: var(--panel-exit);
      }

      .oval-pulse {
        fill: none;
        stroke-linecap: round;
        animation:
          hero-oval-lap var(--dur) cubic-bezier(0.37, 0, 0.63, 1)
          var(--delay) infinite;
      }

      .oval-pulse--rev {
        animation-name: hero-oval-lap-rev;
      }

      /* The extruded circumference itself. Its SVG gradient supplies a
         soft horizontal falloff, so it reads as a curved surface rather
         than another wireframe fence. */
      .oval-wall-surface {
        stroke: none;
        pointer-events: none;
      }

      /* The old 13% moving stripe is no longer drawn on both rims. One
         clipped 60-unit stroke extrudes that exact stripe through the wall:
         same count, green grade, phase, speed, and direction, with no second
         line or inner core layered over it. */
      .oval-wall-panel {
        fill: none;
        stroke: var(--lane-color, #18d383);
        stroke-width: 60;
        stroke-opacity: 0.44;
        stroke-linecap: square !important;
        stroke-linejoin: miter !important;
        stroke-dasharray: 13 87;
        shape-rendering: geometricPrecision;
      }

      @keyframes hero-oval-lap {
        0% { stroke-dashoffset: 0; opacity: 0; }
        7% { opacity: var(--peak, 1); }
        76% { opacity: var(--peak, 1); }
        100% { stroke-dashoffset: -100; opacity: 0; }
      }

      @keyframes hero-oval-lap-rev {
        0% { stroke-dashoffset: 0; opacity: 0; }
        7% { opacity: var(--peak, 1); }
        76% { opacity: var(--peak, 1); }
        100% { stroke-dashoffset: 100; opacity: 0; }
      }

      /* ── Card socials & contact (right column of the card) ── */

      :global(.reactor-card__actions) {
        position: relative;
        z-index: 2;
        align-self: end;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.6rem;
        margin-top: auto;
        padding-top: 0.9rem;
        visibility: hidden;
        pointer-events: auto;
      }

      :global(.reactor-card.is-visible .reactor-card__actions) {
        visibility: visible;
      }

      :global(.reactor-card__icon) {
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        color: var(--card-green-deep);
        background: rgba(255, 255, 250, 0.66);
        border: 1px solid rgba(174, 134, 34, 0.56);
        border-radius: 2px;
        transition:
          border-color 0.2s ease,
          color 0.2s ease,
          background 0.2s ease,
          transform 0.2s ease;
      }

      :global(.reactor-card__icon:hover) {
        color: var(--card-ivory);
        border-color: var(--card-gold);
        background: var(--card-green-deep);
        transform: translateY(-2px);
      }

      :global(.reactor-card__icon svg) {
        width: 1.15rem;
        height: 1.15rem;
        fill: currentColor;
      }

      :global(.reactor-card__cta) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        height: 2.75rem;
        padding: 0 1.15rem;
        margin-left: 0.4rem;
        font-family: var(--font-mono);
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--card-ivory);
        background: linear-gradient(135deg, var(--card-green-deep), var(--card-green));
        border: 1px solid var(--card-gold);
        border-radius: 2px;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.18),
          0 5px 16px rgba(8, 69, 48, 0.16);
        transition: filter 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      }

      :global(.reactor-card__cta:hover) {
        filter: brightness(1.08);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.28),
          0 7px 20px rgba(8, 69, 48, 0.22),
          0 0 0 1px rgba(255, 253, 244, 0.46);
        transform: translateY(-2px);
      }

      @media (max-width: 960px) {
        :global(.reactor-card) {
          min-height: clamp(370px, 46vh, 500px);
        }

        :global(.reactor-card__circuit) {
          opacity: 0.78;
        }

        :global(.reactor-card__body) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        :global(.reactor-card__body p:last-child) {
          grid-column: 1 / -1;
          justify-self: center;
          width: 66.666%;
        }

        :global(.reactor-card p) {
          font-size: var(--card-copy-fit, clamp(0.74rem, 1vw, 0.82rem));
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .headline__outline::after {
          animation: none !important;
          opacity: 0 !important;
        }

        .hero-oval,
        .oval-lane,
        .oval-panels {
          transition: none !important;
        }

        .oval-lane,
        .oval-panels {
          transform: none !important;
        }

        .oval-pulse {
          animation: none !important;
          opacity: 0.5;
        }

        :global(.reactor-card__icon),
        :global(.reactor-card__cta),
        :global(.reactor-card::after),
        :global(.reactor-card__circuit-grooves path),
        :global(.reactor-card__circuit-metal path),
        :global(.reactor-card__circuit-pads rect) {
          animation: none !important;
          transition: none;
        }
        :global(.reactor-card::after) {
          opacity: 0.82;
          clip-path: none;
        }
        :global(.reactor-card__circuit-grooves path),
        :global(.reactor-card__circuit-metal path) {
          opacity: 1;
          stroke-dashoffset: 0;
        }
        :global(.reactor-card__circuit-pads rect) {
          opacity: 1;
        }
        :global(.reactor-card__icon:hover),
        :global(.reactor-card__cta:hover) {
          transform: none;
        }
      }

      @media (max-width: 720px) {
        /* Mobile staging, act 1: the headline owns the top, the scene owns
           the middle on its own, a thin subtitle + chip strip sits at the
           bottom. Act 2: the reactor card covers the strip as a bottom
           sheet; the strip fades under it. */
        main {
          width: 100%;
          height: 100dvh;
          min-height: 100svh;
          justify-content: flex-start;
          padding:
            calc(var(--safe-top) + 7.6rem)
            calc(var(--safe-right) + 1.25rem)
            calc(var(--safe-bottom) + 0.9rem)
            calc(var(--safe-left) + 1.25rem);
        }

        :global(body.reactor-card-visible) main {
          padding-bottom: 0.9rem;
        }

        .brand {
          top: calc(var(--safe-top) + 1.1rem);
          left: calc(var(--safe-left) + 1.25rem);
        }

        .lang {
          top: calc(var(--safe-top) + 1.2rem);
          right: calc(var(--safe-right) + 1.25rem);
        }

        .eyebrow {
          font-size: clamp(0.56rem, 2.5vw, 0.62rem);
          letter-spacing: 0.18em;
          margin-bottom: 0.7rem;
          white-space: nowrap;
        }

        h1 {
          --mobile-title-size: min(12.4vw, 5.6svh);
          font-size: var(--mobile-title-size);
          margin-bottom: 0;
        }

        .subtitle {
          margin-top: auto;
          max-width: 100%;
          font-size: 0.95rem;
          line-height: 1.5;
        }

        .tech-stack {
          align-self: stretch;
          width: 100%;
          min-width: 0;
          margin-top: 0.75rem;
          max-width: 100%;
          gap: 0.45rem;
          flex-wrap: nowrap;
          overflow-x: auto;
          padding-bottom: 0.35rem;
          pointer-events: auto;
          -webkit-overflow-scrolling: touch;
          overscroll-behavior-inline: contain;
          scrollbar-width: none;
          mask-image: linear-gradient(90deg, #000 0, #000 86%, transparent 100%);
          -webkit-mask-image: linear-gradient(90deg, #000 0, #000 86%, transparent 100%);
        }

        .tech-stack::-webkit-scrollbar {
          display: none;
        }

        .tech-badge {
          flex-shrink: 0;
        }

        /* Mobile has its own stage composition: the sphere occupies the
           centre and the oval becomes its low pedestal. Across the tested
           compact cameras the settled sphere ends near 62svh, so starting
           the oval at 57.2svh lets its upper glow meet the shell instead of
           leaving a dark seam between the two forms. */
        .hero-oval {
          --oval-visibility: 0.5;
          left: 50%;
          bottom: auto;
          top: 57.2svh;
          width: 84vw;
          transform: translateX(-50%);
        }

        .subtitle,
        .tech-stack {
          transition: opacity 0.4s ease;
        }

        :global(body.reactor-card-visible) .subtitle,
        :global(body.reactor-card-visible) .tech-stack {
          opacity: 0;
        }

        :global(.reactor-card) {
          top: calc(
            var(--safe-top) + 7.6rem + 0.82rem + 0.7rem +
              min(32.24vw, 14.56svh) + 0.55rem
          );
          left: 0;
          right: 0;
          bottom: 0;
          width: 100%;
          height: auto;
          min-height: 0;
          max-height: none;
          padding:
            0.85rem
            calc(var(--safe-right) + 1rem)
            calc(var(--safe-bottom) + 0.75rem)
            calc(var(--safe-left) + 1rem);
          overflow: hidden;
          overscroll-behavior: none;
        }

        :global(.reactor-card__circuit) {
          opacity: 0.58;
        }

        :global(.reactor-card__content) {
          min-height: 0;
          overflow: hidden;
        }

        :global(.reactor-card__body) {
          flex: 1 1 0;
          min-height: 0;
          display: grid;
          grid-template-columns: none;
          grid-auto-flow: column;
          grid-auto-columns: calc(100% - 1.15rem);
          align-items: stretch;
          gap: 0.65rem;
          padding: 0 1.15rem 0.35rem 0;
          overflow-x: auto;
          overflow-y: hidden;
          scroll-snap-type: x mandatory;
          scroll-padding-inline: 0;
          overscroll-behavior-inline: contain;
          touch-action: pan-x;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
        }

        :global(.reactor-card__body::-webkit-scrollbar) {
          display: none;
        }

        :global(.reactor-card__body p),
        :global(.reactor-card__body p:last-child) {
          grid-column: auto;
          align-self: stretch;
          justify-self: stretch;
          width: auto;
          height: 100%;
          min-width: 0;
          margin: 0;
          padding: 0.8rem 0.78rem;
          overflow: hidden;
          scroll-snap-align: start;
          scroll-snap-stop: always;
          border: 1px solid rgba(166, 127, 31, 0.46);
          background:
            radial-gradient(circle at 100% 0, rgba(199, 162, 71, 0.13), transparent 38%),
            linear-gradient(145deg, rgba(255, 255, 251, 0.82), rgba(222, 238, 223, 0.74));
          box-shadow:
            inset 0 0 24px rgba(255, 255, 255, 0.52),
            inset 0 -1px 0 rgba(32, 105, 68, 0.12),
            0 8px 24px rgba(4, 51, 31, 0.11);
          text-align: left;
        }

      :global(.reactor-card__body p::before) {
          content: attr(data-page);
          display: block;
          margin-bottom: 0.58rem;
          color: rgba(137, 101, 20, 0.78);
          font: 400 0.72rem/0.9 var(--font-vyaz);
          letter-spacing: 0.08em;
        }

        :global(.reactor-card__actions) {
          flex: 0 0 auto;
          align-self: stretch;
          justify-content: flex-start;
          flex-wrap: nowrap;
          gap: 0.45rem;
          padding-top: 0.65rem;
        }

        :global(.reactor-card__icon) {
          flex: 0 0 2.5rem;
          width: 2.5rem;
          height: 2.5rem;
        }

        :global(.reactor-card__cta) {
          flex: 1 1 auto;
          min-width: 0;
          height: 2.5rem;
          margin-left: 0;
          padding: 0 0.65rem;
          font-size: 0.64rem;
          letter-spacing: 0.075em;
          white-space: nowrap;
        }

        :global(.reactor-card__meta) {
          margin-bottom: 0.48rem;
          font-size: 0.6rem;
        }

        :global(.reactor-card h2) {
          margin-bottom: 0.5rem;
          font-size: 1.06rem;
          line-height: 1.02;
        }

        :global(.reactor-card p) {
          font-size: var(--card-copy-fit, 0.75rem);
          line-height: 1.34;
          letter-spacing: 0.006em;
        }

        /* Static extension-grid fallback: suspended iframes may never run the
           ResizeObserver fitter. These curves mirror its measured RU/EN card
           sizes; a hydrated card's inline custom property still wins. */
        :global(html[data-viewport-lab-card] .reactor-card__body p:nth-child(1)) {
          --card-copy-fit: clamp(20px, 6.13vw, 26px);
        }

        :global(html[data-viewport-lab-card] .reactor-card__body p:nth-child(2)) {
          --card-copy-fit: clamp(16px, 4.84vw, 20px);
        }

        :global(html[data-viewport-lab-card] .reactor-card__body p:nth-child(3)) {
          --card-copy-fit: clamp(17px, 5.12vw, 22px);
        }

        :global(html[lang='en'][data-viewport-lab-card] .reactor-card__body p:nth-child(2)) {
          --card-copy-fit: clamp(17px, 5.13vw, 22px);
        }

        :global(html[lang='en'][data-viewport-lab-card] .reactor-card__body p:nth-child(3)) {
          --card-copy-fit: clamp(18px, 5.65vw, 24px);
        }
      }

      /* Common narrow Android/iPhone widths lose the final action row by
         only a few lines of slab copy. Give the bottom sheet the title's
         remaining gap and tighten its internal rhythm without changing the
         single-column composition or the larger 384px+ mobile treatment. */
      @media (max-width: 380px) {
        :global(.reactor-card) {
          top: calc(
            var(--safe-top) + 7.6rem + 0.82rem + 0.7rem +
              min(32.24vw, 14.56svh) + 0.05rem
          );
          padding-top: 0.7rem;
          padding-bottom: calc(var(--safe-bottom) + 0.55rem);
        }

        :global(.reactor-card__meta) {
          margin-bottom: 0.32rem;
        }

        :global(.reactor-card h2) {
          margin-bottom: 0.36rem;
          font-size: 1rem;
        }

        :global(.reactor-card__body) {
          gap: 0.34rem;
        }

        :global(.reactor-card p) {
          padding-top: 0.44rem;
          font-size: var(--card-copy-fit, 0.72rem);
          line-height: 1.3;
        }

        :global(.reactor-card__actions) {
          gap: 0.38rem;
          padding-top: 0.48rem;
        }

        :global(.reactor-card__icon) {
          flex-basis: 2.35rem;
          width: 2.35rem;
          height: 2.35rem;
        }

        :global(.reactor-card__cta) {
          height: 2.35rem;
          font-size: 0.61rem;
        }
      }

      /* On short portrait phones the title-derived card offset leaves too
         little room for a complete page. Start just below the persistent
         brand rail; the horizontal pager then owns the remaining height. */
      @media (max-width: 720px) and (max-height: 680px) and (orientation: portrait) {
        :global(.reactor-card) {
          top: calc(var(--safe-top) + 7rem);
        }

        :global(.reactor-card__body p),
        :global(.reactor-card__body p:last-child) {
          padding: 0.62rem 0.68rem;
        }

        :global(.reactor-card__body p::before) {
          margin-bottom: 0.42rem;
        }
      }

      /* Short landscape screens are a separate composition: identity stays
         in the left rail, WebGL owns the middle/right, and the final
         information surface becomes a scrollable right-hand panel. */
      @media (max-width: 1180px) and (max-height: 800px) and (orientation: landscape) {
        main {
          width: 44%;
          height: 100dvh;
          min-height: 0;
          justify-content: center;
          padding:
            calc(var(--safe-top) + 4.7rem)
            0.75rem
            calc(var(--safe-bottom) + 0.8rem)
            calc(var(--safe-left) + 1rem);
        }

        .brand {
          top: calc(var(--safe-top) + 0.65rem);
          left: calc(var(--safe-left) + 1rem);
          font-size: 0.56rem;
        }

        .lang {
          top: calc(var(--safe-top) + 0.8rem);
          right: calc(var(--safe-right) + 1rem);
        }

        .eyebrow {
          margin-bottom: 0.55rem;
          font-size: 0.57rem;
          letter-spacing: 0.16em;
          white-space: nowrap;
        }

        h1 {
          font-size: min(6vw, 10.5svh);
          margin-bottom: 0;
        }

        .subtitle {
          margin-top: 0.85rem;
          max-width: 34ch;
          font-size: 0.8rem;
          line-height: 1.38;
        }

        .tech-stack {
          display: none;
        }

        :global(body.reactor-card-visible) main {
          padding-bottom: calc(var(--safe-bottom) + 0.8rem);
        }

        :global(.reactor-card) {
          top: 0;
          right: 0;
          bottom: 0;
          left: 44%;
          width: auto;
          height: 100dvh;
          min-height: 0;
          max-height: none;
          padding:
            calc(var(--safe-top) + 0.85rem)
            calc(var(--safe-right) + 1rem)
            calc(var(--safe-bottom) + 0.85rem)
            1rem;
          overflow-y: auto;
          overscroll-behavior: contain;
          border-top: 0;
          border-left: 1px solid rgba(175, 136, 39, 0.78);
        }

        :global(.reactor-card__meta) {
          margin-bottom: 0.5rem;
          font-size: 0.57rem;
        }

        :global(.reactor-card h2) {
          margin-bottom: 0.55rem;
          font-size: 1rem;
        }

        :global(.reactor-card__content) {
          overflow: visible;
        }

        :global(.reactor-card__body) {
          flex: none;
          min-height: auto;
          grid-template-columns: 1fr;
          grid-auto-flow: row;
          grid-auto-columns: auto;
          gap: 0.58rem;
          padding: 0;
          overflow: visible;
          scroll-snap-type: none;
          touch-action: auto;
        }

        :global(.reactor-card__body p:last-child) {
          grid-column: auto;
        }

        :global(.reactor-card__body p),
        :global(.reactor-card__body p:last-child) {
          width: auto;
          height: auto;
          padding: 0.72rem 0 0;
          overflow: visible;
          scroll-snap-align: none;
          scroll-snap-stop: normal;
          border: 0;
          border-top: 1px solid rgba(163, 124, 30, 0.48);
          background: linear-gradient(
            180deg,
            rgba(255, 255, 250, 0.56),
            rgba(224, 238, 223, 0.28)
          );
          box-shadow: inset 0 -1px 0 rgba(36, 112, 72, 0.13);
          font-size: var(--card-copy-fit, 0.72rem);
          line-height: 1.38;
          text-align: justify;
        }

        :global(.reactor-card__body p::before) {
          display: none;
        }

        :global(.reactor-card__actions) {
          align-self: stretch;
          justify-content: flex-start;
          flex-wrap: nowrap;
          gap: 0.4rem;
          padding-top: 0.72rem;
        }

        :global(.reactor-card__icon) {
          flex: 0 0 2.35rem;
          width: 2.35rem;
          height: 2.35rem;
        }

        :global(.reactor-card__cta) {
          flex: 1 1 auto;
          min-width: 0;
          height: 2.35rem;
          margin-left: 0;
          padding: 0 0.6rem;
          font-size: 0.59rem;
          letter-spacing: 0.065em;
          white-space: nowrap;
        }
      }
    </style>
  </head>
  <body>
    <script is:inline>
      if (document.documentElement.hasAttribute('data-viewport-lab-card')) {
        document.body.classList.add('reactor-card-visible')
      }
    </script>
    <HeroScene client:load copy={t.card} />
    <div class="hero-nebula" aria-hidden="true"></div>

    <header class="brand">
      <BrandMark />
    </header>

    <nav class="lang" aria-label={t.ariaLang}>
      <a
        class:list={['lang__link', { 'is-active': lang === 'ru' }]}
        href="/"
        aria-current={lang === 'ru' ? 'page' : undefined}>RU</a
      >
      <span class="lang__sep" aria-hidden="true">/</span>
      <a
        class:list={['lang__link', { 'is-active': lang === 'en' }]}
        href="/en/"
        aria-current={lang === 'en' ? 'page' : undefined}>EN</a
      >
    </nav>

    <main>
      {/* Air-support cylinders: the original nested circumference lines
          are extruded into continuous walls. The far half-surface lives
          below the text; the near half-surface is painted after it, so
          the flat copy sits inside the translucent tubes. Each former
          top/base stripe pair is now one panel spanning the wall. */}
      <svg class="hero-oval hero-oval--back" viewBox="0 0 1200 400" aria-hidden="true">
        <defs>
          {OVAL_LANES.map((lane, index) => (
            <linearGradient id={`oval-wall-far-${index}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color={lane.color} stop-opacity="0.1" />
              <stop offset="0.16" stop-color={lane.color} stop-opacity="0.035" />
              <stop offset="0.5" stop-color={lane.color} stop-opacity="0.018" />
              <stop offset="0.84" stop-color={lane.color} stop-opacity="0.035" />
              <stop offset="1" stop-color={lane.color} stop-opacity="0.1" />
            </linearGradient>
          ))}
          {OVAL_LANES.map((lane, index) => (
            <clipPath id={`oval-wall-far-clip-${index}`} clipPathUnits="userSpaceOnUse">
              <path d={ovalFarWall(lane)} />
            </clipPath>
          ))}
        </defs>
        {OVAL_LANES.map((lane, index) => (
          <g class="oval-lane" style={ovalLaneStyle(lane, index, false)}>
            <path class="oval-wall-surface" fill={`url(#oval-wall-far-${index})`} d={ovalFarWall(lane)} />
            <g class="oval-panels" clip-path={`url(#oval-wall-far-clip-${index})`}>
              <path class:list={['oval-pulse', 'oval-wall-panel', { 'oval-pulse--rev': lane.rev }]} pathLength="100" d={ovalFarArc(lane, OVAL_MID_CY)} />
            </g>
          </g>
        ))}
      </svg>

      <p class="eyebrow">{t.eyebrow}</p>

      <h1>
        <span class="headline__solid">WebGL</span>
        <span class="headline__outline" data-text="Developer">Developer</span>
      </h1>

      <p class="subtitle">{t.subtitle}</p>

      <div class="tech-stack">
        <span class="tech-badge">Three.js</span>
        <span class="tech-badge">WebGL</span>
        <span class="tech-badge">GLSL</span>
        <span class="tech-badge">React Three Fiber</span>
        <span class="tech-badge">Mapbox</span>
        <span class="tech-badge">React</span>
        <span class="tech-badge">TypeScript</span>
        <span class="tech-badge">Next.js</span>
        <span class="tech-badge">Astro</span>
        <span class="tech-badge">Node.js</span>
        <span class="tech-badge">GSAP</span>
        <span class="tech-badge">Rapier</span>
      </div>

      {/* Near half-surfaces and panels — same geometry as above, painted
          after the copy so the cylinder wall passes in front. */}
      <svg class="hero-oval hero-oval--front" viewBox="0 0 1200 400" aria-hidden="true">
        <defs>
          {OVAL_LANES.map((lane, index) => (
            <linearGradient id={`oval-wall-near-${index}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color={lane.color} stop-opacity="0.075" />
              <stop offset="0.18" stop-color={lane.color} stop-opacity="0.026" />
              <stop offset="0.5" stop-color={lane.color} stop-opacity="0.012" />
              <stop offset="0.82" stop-color={lane.color} stop-opacity="0.026" />
              <stop offset="1" stop-color={lane.color} stop-opacity="0.075" />
            </linearGradient>
          ))}
          {OVAL_LANES.map((lane, index) => (
            <clipPath id={`oval-wall-near-clip-${index}`} clipPathUnits="userSpaceOnUse">
              <path d={ovalNearWall(lane)} />
            </clipPath>
          ))}
        </defs>
        {OVAL_LANES.map((lane, index) => (
          <g class="oval-lane" style={ovalLaneStyle(lane, index, true)}>
            <path class="oval-wall-surface" fill={`url(#oval-wall-near-${index})`} d={ovalNearWall(lane)} />
            <g class="oval-panels" clip-path={`url(#oval-wall-near-clip-${index})`}>
              <path class:list={['oval-pulse', 'oval-wall-panel', { 'oval-pulse--rev': lane.rev }]} pathLength="100" d={ovalNearArc(lane, OVAL_MID_CY)} />
            </g>
          </g>
        ))}
      </svg>
    </main>
  </body>
</html>
