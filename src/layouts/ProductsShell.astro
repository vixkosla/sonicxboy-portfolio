---
import '@fontsource-variable/onest'
import '@fontsource-variable/jetbrains-mono'
import { ClientRouter } from 'astro:transitions'
import BrandMark from '../components/BrandMark.astro'
import { SITE } from '../i18n.ts'
import { PRODUCT_TREE, PRODUCTS, PRODUCTS_CRUMB, type Crumb } from '../data/products.ts'

interface Props {
  title: string
  description: string
  // Path segments after /products/, e.g. ['telegram-mcp', 'install.md'].
  file: string[]
  crumbs: Crumb[]
  schema?: Record<string, unknown>
}

const { title, description, file, crumbs, schema } = Astro.props
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`
const canonical = `${SITE}${pathname}`

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'SonicXBoy', href: '/' }, PRODUCTS_CRUMB, ...crumbs]
    .filter((crumb, index, all) => all.findIndex((other) => other.href === crumb.href) === index)
    .map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: `${SITE}${crumb.href}`,
    })),
}

// Rendered as a file tree. Glyphs are computed from depth and the next
// sibling so the ASCII branches stay correct when entries are added.
const rows = PRODUCT_TREE.map((entry, index) => {
  const rest = PRODUCT_TREE.slice(index + 1)
  const nextSibling = rest.find((other) => other.depth <= entry.depth)
  const last = !nextSibling || nextSibling.depth < entry.depth
  const parentLast =
    entry.depth === 2 &&
    !PRODUCT_TREE.slice(index + 1).some((other) => other.depth === 1)
  const indent = entry.depth === 2 ? (parentLast ? '   ' : '│  ') : ''
  return { ...entry, glyph: `${indent}${last ? '└─' : '├─'}` }
})

// Narrow screens drop the tree for a short nav: the products themselves on
// the index, or the current product's pages plus a way back.
const current = PRODUCTS.find((product) => product.slug === file[0])
const mobileLinks = current
  ? [
      { href: '/products/', label: 'Все продукты' },
      ...PRODUCT_TREE.filter((entry) => entry.depth === 2 && entry.href.startsWith(current.href)).map(
        (entry) => ({ href: entry.href, label: entry.label }),
      ),
    ]
  : PRODUCTS.map((product) => ({ href: product.href, label: product.name }))
const here = pathname
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#050907" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SonicXBoy" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#readme">К содержанию</a>

    <header class="bar" transition:persist="products-bar">
      <span class="bar__mark"><BrandMark /></span>
      <nav class="bar__nav" aria-label="Разделы сайта">
        <a href="/">Главная</a>
        <a href="/products/" data-section>Продукты</a>
        <a href="https://github.com/vixkosla" rel="me">GitHub</a>
      </nav>
    </header>

    <div class="frame">
      <aside class="tree" transition:persist="products-tree" aria-label="Страницы раздела">
        <p class="tree__root">~/products</p>
        <ul>
          {rows.map((row) =>
            row.folder ? (
              <li class="tree__row tree__row--folder">
                <span class="tree__glyph" aria-hidden="true">{row.glyph}</span>
                <span class="tree__file">{row.file}</span>
              </li>
            ) : (
              <li class="tree__row">
                <span class="tree__glyph" aria-hidden="true">{row.glyph}</span>
                <a class="tree__link" href={row.href} data-tree-link>
                  <span class="tree__file">{row.file}</span>
                  <span class="tree__label">{row.label}</span>
                </a>
              </li>
            ),
          )}
        </ul>
      </aside>

      <main id="readme" class="readme" transition:animate="fade">
        <nav class="mnav" aria-label={current ? current.name : 'Продукты'}>
          {mobileLinks.map((link) => (
            <a href={link.href} aria-current={link.href === here ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
        <p class="path" aria-label="Путь к странице">
          <span class="path__dim">~/products/</span>{file.join('/')}
        </p>
        <slot />
      </main>
    </div>

    <footer class="foot">
      <span>© SonicXBoy · Санкт-Петербург</span>
      <a href="https://t.me/vixkosla">Написать в Telegram</a>
    </footer>

    <script>
      // The tree and bar persist between pages, so their current-page state
      // is refreshed after every client-side swap rather than in the markup.
      const markCurrent = () => {
        const here = window.location.pathname.replace(/\/?$/, '/')
        document.querySelectorAll<HTMLAnchorElement>('[data-tree-link]').forEach((link) => {
          if (link.pathname === here) link.setAttribute('aria-current', 'page')
          else link.removeAttribute('aria-current')
        })
        document.querySelectorAll<HTMLAnchorElement>('[data-section]').forEach((link) => {
          link.setAttribute('aria-current', 'location')
        })
      }
      document.addEventListener('astro:page-load', markCurrent)
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --bg: #050907;
    --panel: #08100c;
    --ink: #e8f5ee;
    --ink-dim: rgba(218, 238, 229, 0.72);
    --ink-faint: rgba(218, 238, 229, 0.46);
    --line: rgba(24, 211, 131, 0.16);
    --line-strong: rgba(24, 211, 131, 0.34);
    --emerald: #18d383;
    --mint: #7dffc7;
    --emerald-deep: #0a7a4c;
    --mono: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace;
    --body: 'Onest Variable', system-ui, sans-serif;
    --tree-w: 17.5rem;
    color-scheme: dark;
  }

  html {
    background: var(--bg);
    scroll-padding-top: 5.5rem;
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(24, 211, 131, 0.035) 1px, transparent 1px) 0 0 / 4rem 4rem,
      var(--bg);
    font-family: var(--body);
    font-size: 17px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    color: var(--bg);
    background: var(--emerald);
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 0.85rem;
    color: var(--bg);
    background: var(--emerald);
    font: 600 0.75rem/1 var(--mono);
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: none;
  }

  /* ── Bar ─────────────────────────────────────────────── */

  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0.7rem clamp(1rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
    background: rgba(5, 9, 7, 0.86);
    backdrop-filter: blur(14px);
  }

  .bar__mark {
    display: inline-flex;
    font-size: 0.5rem;
  }

  .bar__nav {
    display: flex;
    gap: clamp(0.9rem, 2.2vw, 2rem);
    font: 600 0.7rem/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bar__nav a {
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .bar__nav a:hover,
  .bar__nav a[aria-current] {
    color: var(--emerald);
  }

  /* ── Frame: persistent tree + README column ──────────── */

  .frame {
    flex: 1;
    display: grid;
    grid-template-columns: var(--tree-w) minmax(0, 1fr);
    width: 100%;
    max-width: 78rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.5rem);
  }

  .tree {
    position: sticky;
    top: 4.5rem;
    align-self: start;
    max-height: calc(100vh - 4.5rem);
    overflow-y: auto;
    padding: 2.6rem 1.5rem 2rem 0;
    border-right: 1px solid var(--line);
    font: 500 0.8rem/1.2 var(--mono);
  }

  .tree__root {
    margin: 0 0 0.9rem;
    color: var(--emerald);
    letter-spacing: 0.04em;
  }

  .tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tree__row {
    display: flex;
    align-items: baseline;
    white-space: pre;
  }

  .tree__glyph {
    flex: none;
    color: var(--line-strong);
  }

  .tree__row--folder .tree__file {
    padding: 0.42rem 0.5rem;
    color: var(--ink);
  }

  .tree__link {
    display: flex;
    flex: 1;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.42rem 0.5rem;
    border-radius: 3px;
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .tree__label {
    color: var(--ink-faint);
    font-family: var(--body);
    font-size: 0.74rem;
  }

  .tree__link:hover {
    color: var(--ink);
    background: rgba(24, 211, 131, 0.07);
  }

  .tree__link[aria-current='page'] {
    color: var(--bg);
    background: var(--emerald);
  }

  .tree__link[aria-current='page'] .tree__label {
    color: rgba(5, 9, 7, 0.72);
  }

  /* ── README typography ───────────────────────────────── */

  /* Text keeps a readable measure; screenshots, code and previews may use
     the full column. */
  .readme {
    min-width: 0;
    max-width: 56rem;
    padding: 2.4rem 0 5rem clamp(1.5rem, 4vw, 4rem);
  }

  .readme > :is(h1, h3, p, ul, ol, blockquote),
  .hero__lead {
    max-width: 42rem;
  }

  .mnav {
    display: none;
  }

  .path {
    margin: 0 0 2.2rem;
    color: var(--ink);
    font: 500 0.74rem/1.4 var(--mono);
    overflow-wrap: anywhere;
  }

  .path__dim {
    color: var(--ink-faint);
  }

  .readme h1,
  .readme h2,
  .readme h3 {
    margin: 0;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .readme h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .readme h2 {
    margin-top: 2.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    font-size: 1.3rem;
  }

  .readme h3 {
    margin-top: 1.8rem;
    font-size: 1.02rem;
  }

  /* Markdown heading markers, dimmed like a raw README. */
  .readme h1::before,
  .readme h2::before,
  .readme h3::before {
    margin-right: 0.55em;
    color: var(--emerald-deep);
    font-family: var(--mono);
    font-weight: 500;
  }

  .readme h1::before {
    content: '#';
  }

  .readme h2::before {
    content: '##';
  }

  .readme h3::before {
    content: '###';
  }

  .readme p,
  .readme ul,
  .readme ol {
    margin: 1rem 0 0;
    color: var(--ink-dim);
  }

  .readme ul,
  .readme ol {
    padding-left: 1.25rem;
  }

  .readme li + li {
    margin-top: 0.35rem;
  }

  .readme li::marker {
    color: var(--emerald);
  }

  .readme strong {
    color: var(--ink);
    font-weight: 620;
  }

  .readme a {
    color: var(--mint);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .readme a:hover {
    text-decoration-color: var(--mint);
  }

  .readme code {
    padding: 0.08em 0.36em;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--ink);
    background: rgba(24, 211, 131, 0.06);
    font: 500 0.84em/1 var(--mono);
  }

  .readme pre {
    margin: 1.2rem 0 0;
    padding: 1rem 1.15rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-left: 2px solid var(--emerald);
    border-radius: 3px;
    background: var(--panel);
    font: 450 0.8rem/1.6 var(--mono);
  }

  .readme pre code {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }

  .readme .lead {
    margin-top: 1.2rem;
    color: var(--ink);
    font-size: 1.12rem;
    line-height: 1.6;
  }

  .readme figure {
    margin: 1.4rem 0 0;
  }

  .readme figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--panel);
  }

  .readme figcaption {
    margin-top: 0.55rem;
    color: var(--ink-faint);
    font: 500 0.72rem/1.45 var(--mono);
  }

  .readme blockquote {
    margin: 1.4rem 0 0;
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 2px solid var(--line-strong);
  }

  .readme blockquote p {
    margin: 0;
  }

  .readme table {
    width: 100%;
    margin-top: 1.2rem;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .readme th,
  .readme td {
    padding: 0.6rem 0.75rem 0.6rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .readme th {
    color: var(--ink-faint);
    font: 600 0.68rem/1.3 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .readme td {
    color: var(--ink-dim);
  }

  .readme td:first-child {
    white-space: nowrap;
  }

  /* Bottom pager: previous / next page in the tree. */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  .readme .pager a {
    display: block;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .readme .pager a:hover {
    border-color: var(--line-strong);
    background: rgba(24, 211, 131, 0.05);
  }

  .pager small {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--ink-faint);
    font: 500 0.72rem/1 var(--mono);
  }

  .pager__next {
    grid-column: 2;
    text-align: right;
  }

  /* ── Product header ─────────────────────────────────── */

  .hero {
    padding-bottom: 2.2rem;
  }

  .hero__lead > p:first-child {
    margin-top: 1.2rem;
    color: var(--ink);
    font-size: 1.14rem;
    line-height: 1.6;
  }

  /* Facts read as a spec sheet: label over value, split by hairlines. */
  .readme .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    margin: 1.8rem 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .facts > div {
    padding: 0.85rem 1rem 0.9rem 0;
  }

  .facts > div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }

  .facts dt {
    color: var(--ink-faint);
    font: 500 0.72rem/1.3 var(--mono);
  }

  /* In row layouts the label sits on the value's baseline. */
  .readme .entry .facts dt {
    padding-top: 0.55rem;
  }

  .facts dd {
    margin: 0.3rem 0 0;
    color: var(--ink);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .readme .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .readme .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.15rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 560;
    text-decoration: none;
    transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
  }

  .readme .button:hover {
    border-color: var(--emerald);
    background: rgba(24, 211, 131, 0.07);
  }

  .readme .button--primary {
    border-color: var(--emerald);
    color: var(--bg);
    background: var(--emerald);
  }

  .readme .button--primary:hover {
    border-color: var(--mint);
    color: var(--bg);
    background: var(--mint);
  }

  /* ── Index: one entry per product ───────────────────── */

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 2.2rem;
    align-items: start;
    margin-top: 2.8rem;
    padding-top: 2.4rem;
    border-top: 1px solid var(--line);
  }

  .readme .entry__dir {
    margin: 0;
    color: var(--emerald);
    font: 500 0.78rem/1.3 var(--mono);
  }

  .readme .entry h2 {
    margin: 0.45rem 0 0;
    padding: 0;
    border: 0;
    font-size: 1.75rem;
  }

  .readme .entry h2::before {
    content: none;
  }

  .readme .entry h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .readme .entry h2 a:hover {
    color: var(--mint);
  }

  .readme .entry .facts {
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 1rem;
    margin-top: 1.2rem;
    border: 0;
  }

  .readme .entry .facts > div {
    display: contents;
  }

  .readme .entry .facts dt,
  .readme .entry .facts dd {
    margin: 0;
    padding: 0.4rem 0;
    border-top: 1px solid var(--line);
  }

  .readme .entry .facts dd {
    font-size: 0.86rem;
  }

  .readme .entry .actions {
    margin-top: 1.3rem;
  }

  .preview {
    display: block;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--panel);
    overflow: hidden;
  }

  .readme a.preview {
    text-decoration: none;
    transition: border-color 0.18s ease;
  }

  .readme a.preview:hover {
    border-color: var(--line-strong);
  }

  .preview img {
    display: block;
    width: 100%;
    height: auto;
  }

  .readme .preview__head {
    margin: 0;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-faint);
    font: 500 0.72rem/1.3 var(--mono);
  }

  /* Agent transcript: who speaks, what tool runs. */
  .readme .chat {
    margin: 0;
    padding: 0.9rem;
    list-style: none;
    font: 450 0.8rem/1.5 var(--mono);
  }

  .readme .chat li {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: 0.6rem;
    margin: 0;
    color: var(--ink-dim);
  }

  .readme .chat li + li {
    margin-top: 0.55rem;
  }

  .chat__who {
    color: var(--ink-faint);
  }

  .chat__you {
    color: var(--ink);
  }

  .chat__tool {
    color: var(--mint);
  }

  .chat__args {
    color: var(--ink-faint);
    overflow-wrap: anywhere;
  }

  /* RZD flow: a real sequence, so it is numbered. The last step is a person. */
  .readme .steps {
    margin: 0;
    padding: 0.4rem 0.9rem 0.9rem;
    list-style: none;
    counter-reset: step;
  }

  .readme .steps li {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr);
    gap: 0.7rem;
    margin: 0;
    padding: 0.7rem 0;
    border-bottom: 1px dashed var(--line);
    counter-increment: step;
  }

  .readme .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--emerald);
    font: 600 0.75rem/1 var(--mono);
  }

  .steps strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  .steps span {
    color: var(--ink-faint);
    font-size: 0.86rem;
  }

  .readme .steps .steps__human {
    border-bottom: 0;
  }

  .readme .steps .steps__human::before {
    border-color: var(--mint);
    color: var(--bg);
    background: var(--mint);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
