---
import '@fontsource-variable/onest'
import '@fontsource-variable/jetbrains-mono'
import { ClientRouter } from 'astro:transitions'
import StatsBrandLockup from '../components/StatsBrandLockup.astro'
import { SITE } from '../i18n.ts'
import { PRODUCT_TREE, PRODUCTS, PRODUCTS_CRUMB, type Crumb } from '../data/products.ts'

interface Props {
  title: string
  description: string
  // Path segments after /products/, e.g. ['telegram-mcp', 'install.md'].
  file: string[]
  crumbs: Crumb[]
  schema?: Record<string, unknown>
}

const { title, description, file, crumbs, schema } = Astro.props
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`
const canonical = `${SITE}${pathname}`

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'SonicXBoy', href: '/' }, PRODUCTS_CRUMB, ...crumbs]
    .filter((crumb, index, all) => all.findIndex((other) => other.href === crumb.href) === index)
    .map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: `${SITE}${crumb.href}`,
    })),
}

// Narrow screens drop the tree for a short nav: the products themselves on
// the index, or the current product's pages plus a way back.
const current = PRODUCTS.find((product) => product.slug === file[0])
const mobileLinks = current
  ? [
      { href: '/products/', label: 'Все продукты' },
      ...PRODUCT_TREE.filter((entry) => entry.depth === 2 && entry.href.startsWith(current.href)).map(
        (entry) => ({ href: entry.href, label: entry.label }),
      ),
    ]
  : PRODUCTS.map((product) => ({ href: product.href, label: product.name }))
const here = pathname
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#060b09" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SonicXBoy" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#readme">К содержанию</a>

    <header class="bar" transition:persist="products-brand-bar">
      <StatsBrandLockup class="products-brand" href="/" label="SonicXBoy — на главную" />
      <nav class="bar__nav" aria-label="Разделы сайта">
        <a href="/">Главная</a>
        <a href="/products/" aria-current="location" data-section>Продукты</a>
        <a href="https://github.com/vixkosla" rel="me">GitHub</a>
      </nav>
    </header>

    <div class="frame">
      <aside class="tree" transition:persist="products-branches-nav-v2" aria-label="Страницы раздела">
        <nav aria-label="Документация">
          <ul>
            {PRODUCT_TREE.map((row) =>
              row.folder ? (
                <li class="tree__group">{row.label}</li>
              ) : (
                <li class:list={['tree__row', { 'tree__row--child': row.depth === 2 }]}>
                  <a class="tree__link" href={row.href} aria-current={row.href === here ? 'page' : undefined} data-tree-link>
                    {row.label}
                  </a>
                </li>
              ),
            )}
          </ul>
        </nav>
      </aside>

      <main id="readme" tabindex="-1" class="readme" transition:animate="fade">
        <nav class:list={['mnav', { 'mnav--index': !current }]} aria-label={current ? current.name : 'Продукты'}>
          {mobileLinks.map((link) => (
            <a href={link.href} aria-current={link.href === here ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
        <slot />
      </main>
    </div>

    <footer class="foot">
      <span>© SonicXBoy · Санкт-Петербург</span>
      <a href="https://t.me/vixkosla">Написать в Telegram</a>
    </footer>

    <script>
      // The tree and bar persist between pages, so their current-page state
      // is refreshed after every client-side swap rather than in the markup.
      const markCurrent = () => {
        const here = window.location.pathname.replace(/\/?$/, '/')
        document.querySelectorAll<HTMLAnchorElement>('[data-tree-link]').forEach((link) => {
          if (link.pathname === here) link.setAttribute('aria-current', 'page')
          else link.removeAttribute('aria-current')
        })
        document.querySelectorAll<HTMLAnchorElement>('[data-section]').forEach((link) => {
          link.setAttribute('aria-current', 'location')
        })
      }
      document.addEventListener('astro:page-load', markCurrent)
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --bg: #060b09;
    --panel: #08100c;
    --ink: #e8f5ee;
    --ink-dim: #afc4b9;
    --ink-faint: #8ca397;
    --line: rgba(24, 211, 131, 0.16);
    --line-strong: rgba(24, 211, 131, 0.34);
    --emerald: #18d383;
    --mint: #7dffc7;
    --emerald-deep: #0a7a4c;
    --mono: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace;
    --body: 'Onest Variable', system-ui, sans-serif;
    --tree-w: 13.5rem;
    --page-width: 74rem;
    --gutter: clamp(1.25rem, 3vw, 2rem);
    --bar-h: 3.5rem;
    color-scheme: dark;
  }

  html {
    background: var(--bg);
    scroll-padding-top: calc(var(--bar-h) + 1.5rem);
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    /* Same restrained upper-right light as the Stats page. */
    background: radial-gradient(ellipse at 80% 0, #12312555, transparent 38rem);
    font-family: var(--body);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    color: var(--bg);
    background: var(--emerald);
  }

  a {
    color: inherit;
  }

  :is(a, button, summary, pre):focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 3px;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 0.85rem;
    color: var(--bg);
    background: var(--emerald);
    font: 600 0.75rem/1 var(--mono);
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: none;
  }

  /* ── Bar ─────────────────────────────────────────────── */

  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--bar-h);
    padding: 0.75rem max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter)));
    border-bottom: 1px solid var(--line);
    background: rgba(6, 11, 9, 0.72);
    backdrop-filter: blur(14px);
  }

  .products-brand {
    flex-shrink: 0;
    font-size: 10px;
  }

  .bar__nav {
    display: flex;
    gap: clamp(0.9rem, 2.2vw, 2rem);
    align-items: center;
    font: 550 0.85rem/1.3 var(--body);
  }

  .bar__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .bar__nav a:hover,
  .bar__nav a[aria-current] {
    color: var(--emerald);
  }

  /* ── Frame: persistent tree + README column ──────────── */

  .frame {
    flex: 1;
    display: grid;
    grid-template-columns: var(--tree-w) minmax(0, 1fr);
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .tree {
    position: sticky;
    top: var(--bar-h);
    align-self: start;
    max-height: calc(100dvh - var(--bar-h));
    overflow-y: auto;
    padding: 2.5rem 1.5rem 2rem 0;
    border-right: 1px dashed var(--line);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tree__group {
    margin: 1.25rem 0 0.35rem;
    color: var(--ink);
    font-weight: 550;
  }

  .tree__link {
    display: block;
    padding: 0.4rem 0;
    color: var(--ink-faint);
    text-decoration: none;
  }

  /* The original README tree's branches, drawn as quiet dashed rules. */
  .tree__row--child {
    position: relative;
    padding-left: 1.1rem;
  }

  .tree__row--child::before,
  .tree__row--child::after {
    position: absolute;
    left: 0.1rem;
    content: '';
    pointer-events: none;
  }

  .tree__row--child::before {
    top: 0;
    height: 100%;
    border-left: 1px dashed var(--line-strong);
  }

  .tree__row--child::after {
    top: 50%;
    width: 0.6rem;
    border-top: 1px dashed var(--line-strong);
  }

  .tree__row--child:has(+ .tree__group)::before,
  .tree__row--child:last-child::before {
    height: 50%;
  }

  .tree__row--child:has([aria-current='page'])::after {
    border-top: 1px solid var(--emerald);
  }

  .tree__link:hover,
  .tree__link[aria-current='page'] {
    color: var(--mint);
  }

  /* ── README typography ───────────────────────────────── */

  /* Text keeps a readable measure; screenshots, code and previews may use
     the full column. */
  .readme {
    min-width: 0;
    max-width: 50rem;
    padding: 2.5rem 0 3.5rem clamp(1.5rem, 3vw, 2.5rem);
  }

  .readme > :is(h1, h3, p, ul, ol, blockquote),
  .hero__lead {
    max-width: 44rem;
  }

  .mnav {
    display: none;
  }

  .readme h1,
  .readme h2,
  .readme h3 {
    margin: 0;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .readme h1 {
    font-size: 1.75rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .readme h2 {
    margin-top: 2rem;
    padding-top: 0;
    font-size: 1.3rem;
  }

  .readme h3 {
    margin-top: 1.8rem;
    font-size: 1.05rem;
  }

  .readme p,
  .readme ul,
  .readme ol {
    margin: 1rem 0 0;
    color: var(--ink-dim);
  }

  .readme ul,
  .readme ol {
    padding-left: 1.25rem;
  }

  .readme li + li {
    margin-top: 0.35rem;
  }

  .readme li::marker {
    color: var(--emerald);
  }

  .readme strong {
    color: var(--ink);
    font-weight: 620;
  }

  .readme a {
    color: var(--mint);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .readme a:hover {
    text-decoration-color: var(--mint);
  }

  .readme code {
    overflow-wrap: anywhere;
    padding: 0.08em 0.36em;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--ink);
    background: rgba(24, 211, 131, 0.06);
    font: 500 0.84em/1 var(--mono);
  }

  .readme pre {
    margin: 1.2rem 0 0;
    padding: 1rem 1.15rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-left: 2px solid var(--emerald);
    border-radius: 3px;
    background: var(--panel);
    font: 450 0.8rem/1.6 var(--mono);
  }

  .readme pre code {
    overflow-wrap: normal;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }

  .readme .lead {
    margin-top: 1.2rem;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.6;
  }

  .readme figure:not(.preview) {
    margin: 1.4rem 0 0;
  }

  .readme figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--panel);
  }

  .readme figcaption {
    margin-top: 0.55rem;
    color: var(--ink-faint);
    font: 450 0.85rem/1.5 var(--body);
  }

  .readme blockquote {
    margin: 1.4rem 0 0;
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 2px solid var(--line-strong);
  }

  .readme blockquote p {
    margin: 0;
  }

  .readme table {
    width: 100%;
    margin-top: 1.2rem;
    border-collapse: collapse;
    font-size: 0.96rem;
  }

  .readme th,
  .readme td {
    padding: 0.6rem 0.75rem 0.6rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .readme th {
    color: var(--ink-faint);
    font: 600 0.85rem/1.4 var(--body);
  }

  .readme td {
    color: var(--ink-dim);
  }

  .readme td:first-child {
    white-space: nowrap;
  }

  /* Bottom pager: previous / next page in the tree. */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  .readme .pager a {
    display: block;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .readme .pager a:hover {
    color: var(--mint);
  }

  .pager small {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--ink-faint);
    font: 500 0.8rem/1.4 var(--mono);
  }

  .pager__next {
    grid-column: 2;
    text-align: right;
  }

  /* ── Product header ─────────────────────────────────── */

  .hero {
    padding-bottom: 0.75rem;
  }

  .hero__lead > p:first-child {
    margin-top: 1.2rem;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Facts read as a spec sheet: label over value, split by hairlines. */
  .readme .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 1.25rem 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .facts > div {
    padding: 0.85rem 1rem 0.9rem 0;
  }

  .facts > div:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }

  .facts dt {
    color: var(--ink-faint);
    font: 500 0.8rem/1.5 var(--mono);
  }

  .facts dd {
    margin: 0.3rem 0 0;
    color: var(--ink);
    font-size: 0.96rem;
    line-height: 1.4;
  }

  .readme .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .readme .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.25rem 0;
    color: var(--mint);
    font-size: 0.875rem;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .readme .button:hover {
    text-decoration-color: var(--mint);
  }

  /* The index is a short directory. Examples and facts live in each document. */
  .entry {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .readme .entry h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .readme .entry h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .readme .entry h2 a:hover {
    color: var(--mint);
  }

  .readme .entry p { max-width: 42rem; margin-top: 0.65rem; }

  .readme .entry__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    font-size: 0.875rem;
  }

  .entry__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .preview {
    min-width: 0;
    align-self: start;
    display: block;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--panel);
    overflow: hidden;
  }

  .readme > .preview {
    margin-top: 1.4rem;
  }

  .readme a.preview {
    text-decoration: none;
    transition: border-color 0.18s ease;
  }

  .readme a.preview:hover {
    border-color: var(--line-strong);
  }

  .preview img {
    display: block;
    width: 100%;
    height: auto;
  }

  .readme .preview__head {
    margin: 0;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-faint);
    font: 500 0.8rem/1.5 var(--mono);
  }

  /* Agent transcript: who speaks, what tool runs. */
  .readme .chat {
    margin: 0;
    padding: 1rem;
    list-style: none;
    font: 450 0.8rem/1.6 var(--mono);
  }

  .readme .chat li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.6rem;
    margin: 0;
    color: var(--ink-dim);
  }

  .readme .chat li + li {
    margin-top: 1rem;
  }

  .chat__who {
    color: var(--ink-faint);
  }

  .chat__you {
    color: var(--ink);
  }

  .chat__tool {
    overflow-wrap: anywhere;
    color: var(--mint);
  }

  .chat__args {
    color: var(--ink-faint);
    overflow-wrap: anywhere;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.6rem max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter)));
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font: 450 0.85rem/1.5 var(--body);
  }

  .foot a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .foot a:hover {
    color: var(--emerald);
  }

  @media (max-width: 900px) {
    .frame {
      grid-template-columns: minmax(0, 1fr);
    }

    .tree { display: none; }

    .readme { width: 100%; max-width: 46rem; margin-inline: auto; padding: 2rem 0 3rem; }

    .mnav {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px dashed var(--line-strong);
    }

    .readme .mnav a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding: 0.5rem 0;
      color: var(--ink-dim);
      font-size: 0.9rem;
      text-decoration: none;
    }

    .readme .mnav a:hover { color: var(--mint); }

    .mnav--index { display: none; }

    .readme .mnav a[aria-current='page'] {
      color: var(--mint);
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }
  }

  @media (max-width: 600px) {
    :root { --bar-h: 3.5rem; }

    body { font-size: 16px; }

    .bar { gap: 0.75rem; }
    .bar__nav { gap: 1rem; font-size: 0.85rem; }
    .bar__nav a:not([data-section]) { display: none; }

    .readme .mnav a { font-size: 0.85rem; }

    .readme h1 { font-size: 1.75rem; }
    .readme .lead, .hero__lead > p:first-child { font-size: 1rem; }

    .readme .facts {
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: 1rem;
      border-bottom: 0;
    }

    .readme .facts > div { display: contents; }

    .readme .facts dt, .readme .facts dd {
      margin: 0;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--line);
    }

    .readme .facts dt { padding-top: 0.7rem; }

    .readme td:first-child { white-space: normal; }
    .readme table { font-size: 0.85rem; overflow-wrap: anywhere; }
    .readme th, .readme td { padding-right: 0.5rem; }
    .readme .chat { padding: 1rem; font-size: 0.8rem; }
    .readme .chat li { grid-template-columns: 2.6rem minmax(0, 1fr); gap: 0.5rem; }
    .readme .preview__head { padding: 0.75rem 1rem; font-size: 0.72rem; }
    .pager { grid-template-columns: 1fr; }
    .pager__next { grid-column: 1; }
    .foot { flex-direction: column; gap: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
    ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
