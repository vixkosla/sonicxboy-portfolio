---
import '@fontsource-variable/onest'
import '@fontsource-variable/jetbrains-mono'
import { SITE, SOURCE_REPOSITORY, type Lang } from '../i18n.ts'
import StatsBrandLockup from '../components/StatsBrandLockup.astro'
import { getStatsDashboard } from '../server/statsDashboard.mjs'
import { dateInZone } from '../server/statsProviders.mjs'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = (ru: string, en: string) => lang === 'ru' ? ru : en
const locale = lang === 'ru' ? 'ru-RU' : 'en-US'
const canonical = SITE + (lang === 'ru' ? '/stats/' : '/en/stats/')
const title = t('Посещаемость и поиск — SonicXBoy', 'Audience and search — SonicXBoy')
const description = t('Актуальная статистика портфолио: посетители, переходы к контакту, источники и видимость в Google.', 'Current portfolio statistics: visitors, contact clicks, traffic sources and Google search visibility.')
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('CDN-Cache-Control', 'no-store')
const dashboard = await getStatsDashboard()
const traffic = dashboard.metrika.data
const google = dashboard.google.data
const number = (value: number | null | undefined) => value == null ? '—' : value.toLocaleString(locale)
const percent = (value: number) => (value * 100).toLocaleString(locale, { maximumFractionDigits: 1 }) + '%'
const date = (value: string | null | undefined) => value ? new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(value + 'T12:00:00Z')) : '—'
const timestamp = (value: string | null | undefined) => value ? new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Moscow', timeZoneName: 'short' }).format(new Date(value)) : '—'
const position = (value: number | null | undefined) => value == null ? '—' : value.toLocaleString(locale, { maximumFractionDigits: 1 })
const sourceNames: Record<string, string> = {
  direct: t('Прямые заходы', 'Direct'),
  organic: t('Поисковые системы', 'Search engines'),
  referral: t('Ссылки с сайтов', 'Other websites'),
  social: t('Социальные сети', 'Social networks'),
  internal: t('Внутренние переходы', 'Internal'),
  ad: t('Реклама', 'Ads'),
  email: t('Почта', 'Email'),
  unknown: t('Источник не определён', 'Unknown source'),
}
const daily = traffic?.daily ?? []
const maxVisits = Math.max(1, ...daily.map((day: { visits: number }) => day.visits))
const organicVisits = traffic?.sources.find((source: { id: string }) => source.id === 'organic')?.visits ?? 0
const mobileVisits = traffic?.devices.filter((device: { type: string }) => device.type === 'Smartphones').reduce((sum: number, device: { visits: number }) => sum + device.visits, 0) ?? 0
const recentVisits = daily.slice(-14).reduce((sum: number, day: { visits: number }) => sum + day.visits, 0)
const earlierVisits = daily.slice(-28, -14).reduce((sum: number, day: { visits: number }) => sum + day.visits, 0)
const hasToday = traffic?.today?.date === dateInZone(new Date(), 'Europe/Moscow')
const metrics = traffic ? [
  { label: t('Посетители', 'Visitors'), value: traffic.totals.users, note: t('за весь период', 'unique across the period') },
  { label: t('Визиты', 'Visits'), value: traffic.totals.visits, note: number(traffic.totals.pageviews) + t(' просмотров страниц', ' pageviews') },
  { label: t('Переходы к контакту', 'Contact visits'), value: traffic.contacts.visits, note: percent(traffic.contacts.conversionRate) + t(' визитов', ' of visits') },
  { label: t('Из поисковиков', 'From search engines'), value: organicVisits, note: t('визиты по данным Метрики', 'visits recorded by Metrica') },
] : []
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={SITE + '/stats/'} />
    <link rel="alternate" hreflang="en" href={SITE + '/en/stats/'} />
    <link rel="alternate" hreflang="x-default" href={SITE + '/stats/'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE + '/og.png'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="topbar">
      <StatsBrandLockup class="brand" href={lang === 'ru' ? '/' : '/en/'} label={t('SonicXBoy — на главную', 'SonicXBoy — home')} />
      <nav aria-label={t('Язык страницы', 'Page language')}>
        <a href="/stats/" aria-current={lang === 'ru' ? 'page' : undefined}>RU</a>
        <span aria-hidden="true">/</span>
        <a href="/en/stats/" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </nav>
    </header>
    <main>
      <div class="page-heading">
        <div>
          <p class="eyebrow">SONICXBOY / STATS</p>
          <h1>{t('Посещаемость и поиск', 'Audience and search')}</h1>
          <p class="intro">{t('Как находят портфолио и доходят до контакта.', 'How people find the portfolio and reach its contact links.')}</p>
        </div>
        <a class="refresh" href={lang === 'ru' ? '/stats/' : '/en/stats/'}>{t('Обновить страницу', 'Refresh page')} <span aria-hidden="true">↻</span></a>
      </div>

      {dashboard.metrika.status === 'stale' && <p class="notice" role="status">{t('Не удалось получить новые данные Метрики. Ниже — последний сохранённый отчёт от ', 'Metrica could not be refreshed. The last saved report is shown, fetched ')}{timestamp(traffic?.refreshedAt)}.</p>}

      {traffic ? (
        <section class="audience" aria-labelledby="audience-title">
          <div class="section-heading">
            <h2 id="audience-title">{t('Аудитория', 'Audience')}</h2>
            <span class="period">{date(traffic.period.startDate)} — {date(traffic.period.endDate)} · {traffic.windowDays} {t('дней', 'days')}</span>
          </div>
          <p class="freshness">
            <span class:list={['status-dot', { stale: dashboard.metrika.status === 'stale' }]} aria-hidden="true" />
            {t('Метрика · получено ', 'Metrica · fetched ')}
            <time datetime={traffic.refreshedAt}>{timestamp(traffic.refreshedAt)}</time>
          </p>
          <div class="metrics">
            {metrics.map((metric) => <div class="metric"><span class="metric-label">{metric.label}</span><strong>{number(metric.value)}</strong><span class="metric-note">{metric.note}</span></div>)}
          </div>
          <p class="contact-note">{t('Переход к контакту — визит с открытием мессенджера; это ещё не отправленное сообщение.', 'A contact visit includes opening a messenger; it does not confirm a message was sent.')}</p>
          <div class="chart-card">
            <div class="chart-heading">
              <h3>{t('Визиты по дням', 'Daily visits')}</h3>
              {hasToday && <p class="today">{t('Сегодня: ', 'Today: ')}<strong>{number(traffic.today.visits)}</strong> <span>{t('· день продолжается', '· in progress')}</span></p>}
            </div>
            <svg class="chart" viewBox="0 0 800 140" role="img" aria-label={t('Визиты за последние полные дни', 'Visits for the last complete days')}>
              <path class="grid" d="M0 20H800 M0 65H800 M0 110H800" />
              {daily.map((day: { date: string; visits: number }, index: number) => {
                const step = 800 / Math.max(1, daily.length)
                const height = day.visits ? 112 * day.visits / maxVisits : 2
                return <rect x={index * step + 4} y={130 - height} width={Math.max(1, step - 8)} height={height} rx="2" class:list={['bar', { 'bar--empty': day.visits === 0 }]}><title>{date(day.date) + ': ' + number(day.visits)}</title></rect>
              })}
            </svg>
            <div class="chart-axis" aria-hidden="true"><span>{date(daily[0]?.date)}</span><span>{date(daily[Math.floor(daily.length / 2)]?.date)}</span><span>{date(daily.at(-1)?.date)}</span></div>
            <div class="chart-foot">
              {daily.length === 28 && <p>{t('Визиты за последние 14 дней: ', 'Visits in the last 14 days: ')}<strong>{number(recentVisits)}</strong>{t(' · за предыдущие 14: ', ' · previous 14: ')}<strong>{number(earlierVisits)}</strong></p>}
              <p>{percent(mobileVisits / Math.max(1, traffic.totals.visits))} {t('визитов — со смартфонов', 'of visits are from smartphones')}</p>
            </div>
          </div>
          <div class="sources-grid">
            <article class="panel">
              <h3>{t('Откуда приходят', 'Traffic sources')}</h3>
              <ul class="source-list">
                {traffic.sources.map((source: { id: string; type: string; visits: number }) => <li><span>{sourceNames[source.id] ?? source.type}</span><strong>{number(source.visits)}</strong><span class="track" aria-hidden="true"><i style={'width:' + Math.min(100, source.visits / Math.max(1, traffic.totals.visits) * 100) + '%'} /></span></li>)}
              </ul>
              <p class="note">{t('Прямые заходы могут включать ссылки, для которых источник не передался.', 'Direct traffic can include links whose source was not passed to the site.')}</p>
            </article>
            <article class="panel">
              <h3>{t('Сайты, которые приводят людей', 'Referring websites')}</h3>
              {traffic.referrers.length ? <ol class="referrers">{traffic.referrers.map((row: { host: string; visits: number }) => <li><span>{row.host}</span><strong>{number(row.visits)}</strong></li>)}</ol> : <p class="empty">{t('За этот период внешние сайты не определены.', 'No referring websites were identified in this period.')}</p>}
              <p class="note">{t('Визиты с известным источником. Собственные проверки сайта отдельно не исключены.', 'Visits with a known referrer. The owner’s own visits are not separately excluded.')}</p>
            </article>
          </div>
        </section>
      ) : (
        <section class="panel unavailable" aria-labelledby="audience-title">
          <h2 id="audience-title">{t('Аудитория', 'Audience')}</h2>
          <p>{t('Свежие данные Метрики сейчас недоступны. Попробуйте обновить страницу позже.', 'Fresh Metrica data is currently unavailable. Please try again later.')}</p>
        </section>
      )}

      <section class="search-section" aria-labelledby="search-title">
        <div class="section-heading"><h2 id="search-title">{t('Видимость в Google', 'Visibility on Google')}</h2><span class="provider">SEARCH CONSOLE</span></div>
        {google ? (
          <>
            {google.source === 'manual-export'
              ? <p class="notice" role="status">{t('Данные Google из ручной выгрузки Search Console. Автоматическое обновление пока не подключено.', 'Google data comes from a manual Search Console export. Automatic refresh is not connected yet.')}</p>
              : dashboard.google.status === 'stale' && <p class="notice" role="status">{t('Обновление Google временно недоступно. Показан сохранённый отчёт.', 'Google could not be refreshed. A saved report is shown.')}</p>}
            <p class="freshness">{date(google.period.startDate)} — {date(google.period.endDate)}{' · '}{google.source === 'manual-export' ? t('импортировано ', 'imported ') : t('получено ', 'fetched ')}<time datetime={google.refreshedAt}>{timestamp(google.refreshedAt)}</time></p>
            <div class="metrics">
              <div class="metric"><span class="metric-label">{t('Показы', 'Impressions')}</span><strong>{number(google.totals.impressions)}</strong><span class="metric-note">{t('появления в результатах поиска', 'appearances in search results')}</span></div>
              <div class="metric"><span class="metric-label">{t('Клики', 'Clicks')}</span><strong>{number(google.totals.clicks)}</strong><span class="metric-note">{t('переходы из Google', 'visits from Google search')}</span></div>
              <div class="metric"><span class="metric-label">CTR</span><strong>{percent(google.totals.ctr)}</strong><span class="metric-note">{t('доля показов с кликом', 'impressions that led to a click')}</span></div>
              <div class="metric"><span class="metric-label">{t('Средняя позиция', 'Average position')}</span><strong>{position(google.totals.position)}</strong><span class="metric-note">{t('по всем показам за период', 'across impressions in this period')}</span></div>
            </div>
            <p class="note google-note">{t('Google публикует данные с задержкой.', 'Google reports data with a delay.')} {google.dataThrough && t('Последний день с данными: ', 'Latest day with data: ') + date(google.dataThrough) + '.'} {google.firstIncompleteDate && t('Данные с ', 'Data from ') + date(google.firstIncompleteDate) + t(' ещё уточняются.', ' is still being finalized.')}</p>
            <div class="query-card">
              <h3>{t('По каким запросам находят', 'Queries that bring people here')}</h3>
              {google.queries.length ? <div class="table-scroll"><table>
                <thead><tr><th scope="col">{t('Запрос', 'Query')}</th><th scope="col">{t('Показы', 'Impressions')}</th><th scope="col">{t('Клики', 'Clicks')}</th><th scope="col">{t('Позиция', 'Position')}</th></tr></thead>
                <tbody>{google.queries.map((row: { query: string; impressions: number; clicks: number; position: number | null }) => <tr><th scope="row">{row.query}</th><td>{number(row.impressions)}</td><td>{number(row.clicks)}</td><td>{position(row.position)}</td></tr>)}</tbody>
              </table></div> : <p class="empty">{t('Google пока не вернул запросы за этот период. Некоторые редкие запросы он скрывает.', 'Google has not returned queries for this period. Some low-volume queries are withheld.')}</p>}
              {google.pages.length > 0 && <p class="landing-pages">{t('Страницы в результатах: ', 'Pages in search results: ')}{google.pages.map((row: { path: string; impressions: number; clicks: number }) => <span><code>{row.path}</code> — {t('показы: ', 'impressions: ')}{number(row.impressions)}{' · '}{t('клики: ', 'clicks: ')}{number(row.clicks)}</span>)}</p>}
            </div>
          </>
        ) : (
          <div class="google-pending">
            <span class="pending-mark" aria-hidden="true">G</span>
            <div>
              <h3>{dashboard.google.status === 'not-connected' ? t('Search Console ещё не подключён', 'Search Console is not connected yet') : t('Данные Google временно недоступны', 'Google data is temporarily unavailable')}</h3>
              <p>{t('Здесь будут показы, клики, позиции и запросы для страниц портфолио. Отсутствие данных не означает нулевые показатели.', 'This report will show portfolio impressions, clicks, positions and queries. Missing data does not mean zero traffic.')}</p>
            </div>
          </div>
        )}
      </section>
      <p class="method">{t('Отчёт учитывает русскую и английскую главные страницы портфолио. Основной период — 28 полных дней, сегодняшний день показан отдельно. Метрика проверяется при открытии страницы; данные Google обновляются автоматически только после подключения API.', 'This report covers the Russian and English portfolio home pages. The main period contains 28 complete days; today is shown separately. Metrica is checked when the page opens; Google data refreshes automatically only after its API is connected.')}</p>
    </main>
    <footer><a href={lang === 'ru' ? '/' : '/en/'}>{t('← Вернуться к портфолио', '← Back to the portfolio')}</a><a href={SOURCE_REPOSITORY}>{t('Исходный код', 'Source code')}</a></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #060b09; color-scheme: dark; }
  :global(body) { margin: 0; color: #e9f1ed; font-family: 'Onest Variable', system-ui, sans-serif; background: radial-gradient(ellipse at 80% 0, #12312555, transparent 38rem); }
  :global(a) { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  :global(a:focus-visible) { outline: 2px solid #82ebbc; outline-offset: 5px; }
  .topbar, main, footer { width: min(1140px, calc(100% - 64px)); margin-inline: auto; }
  .topbar { display: flex; align-items: center; justify-content: space-between; padding: 28px 0; border-bottom: 1px solid #244435; }
  :global(.brand) { font-size: 10px; }
  nav { display: flex; align-items: center; gap: 14px; font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; }
  nav a { padding: 8px 2px; text-decoration: none; color: #91a99a; }
  nav a[aria-current] { color: #85f0bd; }
  nav span { color: #375544; }
  main { padding: 44px 0 28px; }
  h1, h2, h3, p { margin: 0; }
  h1 { font-weight: 600; font-size: clamp(27px, 3.2vw, 39px); letter-spacing: -0.035em; line-height: 1.15; }
  h2 { font-size: 21px; font-weight: 550; letter-spacing: -0.02em; }
  h3 { font-size: 15px; font-weight: 550; }
  .eyebrow, .provider { color: #79c79f; font: 10px 'JetBrains Mono Variable', monospace; letter-spacing: 0.13em; }
  .eyebrow { margin-bottom: 14px; }
  .page-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 42px; }
  .intro { color: #9cb0a5; font-size: 14px; margin-top: 12px; line-height: 1.6; }
  .refresh { display: inline-flex; gap: 18px; align-items: center; flex-shrink: 0; border: 1px solid #3b614c; border-radius: 6px; padding: 12px 16px; font-size: 12px; text-decoration: none; background: #10251a66; }
  .refresh:hover { background: #183c2a; }
  .refresh span { font-size: 18px; color: #7de9b4; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .period { color: #b4c5bc; font-size: 12px; font-variant-numeric: tabular-nums; }
  .freshness { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin-top: 9px; margin-bottom: 20px; color: #8ca699; font-size: 11px; }
  .status-dot { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #71d6a3; margin-right: 3px; }
  .status-dot.stale { background: #edc787; }
  .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid #2b4938; border-radius: 10px; overflow: hidden; background: #0e1c1477; }
  .metric { min-width: 0; display: flex; flex-direction: column; gap: 12px; padding: 23px 24px; border-right: 1px solid #2b4938; }
  .metric:last-child { border: 0; }
  .metric-label { font-size: 12px; color: #b8cbc0; }
  .metric strong { color: #b1f6d1; font-size: clamp(31px, 4vw, 43px); line-height: 1; font-weight: 500; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
  .metric-note { color: #91a799; font-size: 10px; line-height: 1.5; }
  .contact-note { color: #8ca095; font-size: 10px; line-height: 1.6; margin: 12px 0 25px; }
  .chart-card, .panel, .query-card { border: 1px solid #213d2d; background: #0b171080; border-radius: 10px; padding: 24px; }
  .chart-heading { display: flex; align-items: baseline; gap: 14px; justify-content: space-between; }
  .today { font-size: 11px; color: #c0d7c9; }
  .today span { color: #8fa798; }
  .chart { width: 100%; display: block; height: 168px; margin-top: 28px; }
  .grid { stroke: #294032; stroke-width: 1; stroke-dasharray: 3 5; fill: none; }
  .bar { fill: #66d29c; }
  .bar:hover { fill: #b0f8d0; }
  .bar--empty { fill: #446152; }
  .chart-axis { display: flex; justify-content: space-between; color: #849c8d; font-size: 10px; }
  .chart-foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 20px; margin-top: 20px; font-size: 11px; color: #94ad9d; line-height: 1.6; }
  .chart-foot strong { font-weight: 500; color: #cfdfd5; }
  .sources-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 18px; }
  .source-list, .referrers { list-style: none; margin: 24px 0 0; padding: 0; }
  .source-list li { display: grid; grid-template-columns: 1fr auto; column-gap: 12px; row-gap: 8px; font-size: 12px; margin-bottom: 16px; color: #c4d6ca; }
  .source-list strong, .referrers strong { color: #a4e6bf; font-weight: 500; font-variant-numeric: tabular-nums; }
  .track { grid-column: 1 / -1; height: 3px; background: #213d2c; border-radius: 2px; overflow: hidden; }
  .track i { display: block; height: 100%; background: #5caf81; }
  .referrers li { display: flex; justify-content: space-between; gap: 15px; padding: 11px 0; border-bottom: 1px solid #213b2c; font-size: 12px; color: #c4d6ca; }
  .referrers li:first-child { padding-top: 0; }
  .referrers span { overflow-wrap: anywhere; }
  .note { font-size: 10px; line-height: 1.7; color: #8da695; margin-top: 22px; }
  .search-section { margin-top: 42px; }
  .search-section .section-heading { margin-bottom: 16px; }
  .search-section .freshness { margin-top: -4px; }
  .google-pending { display: flex; gap: 24px; align-items: center; padding: 28px; border: 1px dashed #375341; border-radius: 10px; background: #101e1555; }
  .pending-mark { color: #72a588; font-size: 32px; font-weight: 600; }
  .google-pending p { font-size: 12px; color: #9fb6a8; max-width: 650px; line-height: 1.8; margin-top: 9px; }
  .google-note { margin-top: 14px; margin-bottom: 20px; }
  .table-scroll { overflow-x: auto; margin-top: 20px; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; text-align: left; }
  th, td { padding: 13px 10px; border-bottom: 1px solid #253f30; font-weight: 400; }
  thead th { color: #94b3a0; font-size: 10px; }
  th:first-child { padding-left: 0; }
  thead th:not(:first-child), td { text-align: right; font-variant-numeric: tabular-nums; }
  tbody th { min-width: 160px; }
  .landing-pages { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 18px; font-size: 11px; color: #9fb9a9; }
  .empty { font-size: 12px; color: #9eb5a7; line-height: 1.8; margin-top: 20px; }
  .notice { border-left: 2px solid #d1b176; padding: 12px 16px; margin-bottom: 20px; background: #ab852012; color: #e5cfaa; font-size: 12px; line-height: 1.8; }
  .unavailable p { font-size: 13px; line-height: 1.8; margin-top: 14px; color: #a6bbae; }
  .method { font-size: 10px; color: #8aa191; max-width: 850px; line-height: 1.9; margin-top: 28px; }
