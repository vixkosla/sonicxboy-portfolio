---
// SonicXBoy badge: blockbuster-title lockup (SONIC / giant X / BOY)
// inside an angular emblem frame with a top gem. Scales with parent font-size.
---

<a class="brand-mark" href="/" aria-label="SonicXBoy — на главную">
  <span class="brand-mark__frame">
    <span class="brand-mark__plate">
      <span class="brand-mark__line brand-mark__line--top">Sonic</span>
      <span class="brand-mark__x">X</span>
      <span class="brand-mark__line brand-mark__line--bottom">Boy</span>
    </span>
  </span>
  <span class="brand-mark__gem" aria-hidden="true"></span>
</a>

<style>
  .brand-mark {
    --cut: 0.62em;
    position: relative;
    display: inline-block;
    font-family: var(--font-display, 'Unbounded Variable', system-ui, sans-serif);
    line-height: 1;
    color: var(--ink, #e8f5ee);
    text-decoration: none;
    text-transform: uppercase;
    pointer-events: auto;
    filter: drop-shadow(0 0 0.9em rgba(24, 211, 131, 0.16));
  }

  /* Angular frame: emerald layer clipped to a chamfered plate,
     dark plate inset inside it. */
  .brand-mark__frame,
  .brand-mark__plate {
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut)),
      0 var(--cut)
    );
  }

  .brand-mark__frame {
    display: inline-block;
    padding: 1.5px;
    background: linear-gradient(
      170deg,
      rgba(125, 255, 199, 0.85),
      rgba(24, 211, 131, 0.66) 42%,
      rgba(10, 122, 76, 0.72)
    );
  }

  .brand-mark__plate {
    display: inline-grid;
    justify-items: center;
    row-gap: 0.3em;
    padding: 0.95em 1.05em 1.05em;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 0.36em,
        rgba(24, 211, 131, 0.05) calc(0.36em + 1px)
      ),
      linear-gradient(165deg, rgba(9, 26, 19, 0.97), rgba(4, 11, 8, 0.99));
  }

  /* Top gem, sitting on the frame edge like a badge jewel */
  .brand-mark__gem {
    position: absolute;
    top: -0.3em;
    left: 50%;
    width: 0.56em;
    height: 0.56em;
    transform: translateX(-50%) rotate(45deg);
    background: linear-gradient(135deg, #7dffc7, #18d383 55%, #0a7a4c);
    border: 1px solid #050907;
    box-shadow: 0 0 0.55em rgba(24, 211, 131, 0.65);
  }

  .brand-mark__line {
    font-weight: 640;
    white-space: nowrap;
  }

  /* Tracking tuned so both lines match the lockup width;
     negative margin compensates the trailing letter-space. */
  .brand-mark__line--top {
    letter-spacing: 0.34em;
    margin-right: -0.34em;
  }

  .brand-mark__line--bottom {
    letter-spacing: 1.3em;
    margin-right: -1.3em;
  }

  .brand-mark__x {
    position: relative;
    font-size: 2.7em;
    font-weight: 900;
    background: linear-gradient(160deg, #7dffc7 8%, #18d383 46%, #0a7a4c 92%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 0 0.09em rgba(24, 211, 131, 0.55))
      drop-shadow(0 0 0.3em rgba(24, 211, 131, 0.3));
  }

  /* Thin film-title rules flanking the X */
  .brand-mark__x::before,
  .brand-mark__x::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.42em;
    height: 1px;
  }

  .brand-mark__x::before {
    right: 100%;
    margin-right: 0.12em;
    background: linear-gradient(90deg, transparent, rgba(24, 211, 131, 0.65));
  }

  .brand-mark__x::after {
    left: 100%;
    margin-left: 0.12em;
    background: linear-gradient(90deg, rgba(24, 211, 131, 0.65), transparent);
  }
</style>
