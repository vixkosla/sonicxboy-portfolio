---
// SonicXBoy badge: dense blockbuster-title lockup (SONIC / giant X / BOY)
// inside an angular emblem frame. The X spans the full plate width; hairline
// rules separate the rows. Scales with parent font-size.
// Set in Tektur (not the site display font) so the X reads distinctly
// from other X-brands (x.com etc.).
import '@fontsource-variable/tektur'
---

<a class="brand-mark" href="/" aria-label="SonicXBoy — на главную">
  <span class="brand-mark__frame">
    <span class="brand-mark__plate">
      <span class="brand-mark__line brand-mark__line--top">Sonic</span>
      <span class="brand-mark__rule" aria-hidden="true"></span>
      <span class="brand-mark__x">X</span>
      <span class="brand-mark__rule" aria-hidden="true"></span>
      <span class="brand-mark__line brand-mark__line--bottom">Boy</span>
    </span>
  </span>
</a>

<style>
  .brand-mark {
    --cut: 0.5em;
    position: relative;
    display: inline-block;
    font-family: 'Tektur Variable', system-ui, sans-serif;
    line-height: 1;
    color: var(--ink, #e8f5ee);
    text-decoration: none;
    text-transform: uppercase;
    pointer-events: auto;
    filter: drop-shadow(0 0 0.9em rgba(24, 211, 131, 0.16));
  }

  /* Angular frame: emerald layer clipped to a chamfered plate,
     dark plate inset inside it. */
  .brand-mark__frame,
  .brand-mark__plate {
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut)),
      0 var(--cut)
    );
  }

  .brand-mark__frame {
    display: inline-block;
    padding: 1.5px;
    background: linear-gradient(
      170deg,
      rgba(125, 255, 199, 0.85),
      rgba(24, 211, 131, 0.66) 42%,
      rgba(10, 122, 76, 0.72)
    );
  }

  .brand-mark__plate {
    display: inline-grid;
    justify-items: center;
    row-gap: 0.14em;
    padding: 0.48em 0.5em 0.52em;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 0.36em,
        rgba(24, 211, 131, 0.05) calc(0.36em + 1px)
      ),
      linear-gradient(165deg, rgba(9, 26, 19, 0.97), rgba(4, 11, 8, 0.99));
  }

  .brand-mark__line {
    font-weight: 800;
    line-height: 0.92;
    white-space: nowrap;
  }

  /* Tracking tuned so both lines match the X width;
     negative margin compensates the trailing letter-space. */
  .brand-mark__line--top {
    letter-spacing: 0.02em;
    margin-right: -0.02em;
  }

  .brand-mark__line--bottom {
    letter-spacing: 0.62em;
    margin-right: -0.62em;
  }

  /* Full-width hairline rules between the rows */
  .brand-mark__rule {
    justify-self: stretch;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(24, 211, 131, 0.6) 18% 82%,
      transparent
    );
  }

  .brand-mark__x {
    font-size: 3.9em;
    font-weight: 900;
    line-height: 0.8;
    transform: scaleX(1.19);
    background: linear-gradient(160deg, #7dffc7 8%, #18d383 46%, #0a7a4c 92%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 0 0.09em rgba(24, 211, 131, 0.55))
      drop-shadow(0 0 0.3em rgba(24, 211, 131, 0.3));
  }
</style>
