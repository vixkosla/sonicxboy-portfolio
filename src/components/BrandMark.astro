---
// SonicXBoy badge: dense lockup (SONIC / giant X / BOY) inside an angular
// emblem frame. The X is Tektur (notched, reads distinctly from other
// X-brands); the small lines are JetBrains Mono for legibility at badge
// sizes. Scales with parent font-size.
import '@fontsource-variable/tektur'
import '@fontsource-variable/jetbrains-mono'
---

<a class="brand-mark" href="/" aria-label="SonicXBoy — на главную">
  <span class="brand-mark__frame">
    <span class="brand-mark__plate">
      <span class="brand-mark__line brand-mark__line--top">Sonic</span>
      <span class="brand-mark__rule" aria-hidden="true"></span>
      <span class="brand-mark__x">X</span>
      <span class="brand-mark__rule" aria-hidden="true"></span>
      <span class="brand-mark__line brand-mark__line--bottom">Boy</span>
    </span>
  </span>
</a>

<style>
  .brand-mark {
    --cut: 0.5em;
    position: relative;
    display: inline-block;
    line-height: 1;
    color: var(--ink, #e8f5ee);
    text-decoration: none;
    text-transform: uppercase;
    pointer-events: auto;
    filter: drop-shadow(0 0 0.9em rgba(24, 211, 131, 0.16));
  }

  /* Angular frame: emerald layer clipped to a chamfered plate,
     dark plate inset inside it. */
  .brand-mark__frame,
  .brand-mark__plate {
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut)),
      0 var(--cut)
    );
  }

  .brand-mark__frame {
    display: inline-block;
    padding: 1.5px;
    background: linear-gradient(
      170deg,
      rgba(125, 255, 199, 0.85),
      rgba(24, 211, 131, 0.66) 42%,
      rgba(10, 122, 76, 0.72)
    );
  }

  .brand-mark__plate {
    display: inline-grid;
    justify-items: center;
    row-gap: 0.16em;
    padding: 0.5em 0.52em 0.55em;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 0.36em,
        rgba(24, 211, 131, 0.05) calc(0.36em + 1px)
      ),
      linear-gradient(165deg, rgba(9, 26, 19, 0.97), rgba(4, 11, 8, 0.99));
  }

  /* Small lines: mono for guaranteed legibility at tiny sizes */
  .brand-mark__line {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  /* Tracking tuned so both lines match the lockup width;
     negative margin compensates the trailing letter-space. */
  .brand-mark__line--top {
    letter-spacing: 0.1em;
    margin-right: -0.1em;
  }

  .brand-mark__line--bottom {
    font-size: 1.14em;
    letter-spacing: 0.55em;
    margin-right: -0.55em;
  }

  /* Full-width hairline rules between the rows */
  .brand-mark__rule {
    justify-self: stretch;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(24, 211, 131, 0.6) 18% 82%,
      transparent
    );
  }

  .brand-mark__x {
    font-family: 'Tektur Variable', system-ui, sans-serif;
    font-size: 4.35em;
    font-weight: 900;
    line-height: 0.8;
    transform: scaleX(1.24);
    background: linear-gradient(160deg, #7dffc7 8%, #18d383 46%, #0a7a4c 92%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 0 0.09em rgba(24, 211, 131, 0.55))
      drop-shadow(0 0 0.3em rgba(24, 211, 131, 0.3));
  }
</style>
