---
// Horizontal SONIC X BOY wordmark in the same Tektur/X treatment as the
// badge emblem: stretched letters, chamfered reactor frame, no mid rules.
import '@fontsource-variable/tektur'

interface Props {
  href?: string
  label?: string
  class?: string
}

const {
  href = '/',
  label = 'SONIC X BOY — на главную',
  class: className,
} = Astro.props
---

<a class:list={['wordmark', className]} href={href} aria-label={label} title={label}>
  <span class="wordmark__frame">
    <span class="wordmark__plate">
      <span class="wordmark__text" aria-hidden="true">
        <span class="wordmark__chunk">SONIC</span>
        <span class="wordmark__x">X</span>
        <span class="wordmark__chunk">BOY</span>
      </span>
      <span class="visually-hidden">SONIC X BOY</span>
    </span>
  </span>
</a>

<style>
  .wordmark {
    --cut: 0.42em;
    position: relative;
    display: inline-block;
    line-height: 1;
    text-decoration: none;
    color: inherit;
    pointer-events: auto;
    filter: drop-shadow(0 0 0.85em rgba(24, 211, 131, 0.18));
    transition: filter 0.2s ease;
  }

  .wordmark:hover {
    filter: drop-shadow(0 0 1.1em rgba(24, 211, 131, 0.42));
  }

  .wordmark__frame,
  .wordmark__plate {
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut)),
      0 var(--cut)
    );
  }

  .wordmark__frame {
    display: inline-block;
    padding: 1.5px;
    background: linear-gradient(
      170deg,
      rgba(125, 255, 199, 0.88),
      rgba(24, 211, 131, 0.66) 42%,
      rgba(10, 122, 76, 0.72)
    );
  }

  .wordmark__plate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.38em 0.72em 0.42em;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 0.34em,
        rgba(24, 211, 131, 0.045) calc(0.34em + 1px)
      ),
      linear-gradient(165deg, rgba(9, 26, 19, 0.97), rgba(4, 11, 8, 0.99));
  }

  .wordmark__text {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    font-family: 'Tektur Variable', system-ui, sans-serif;
    font-weight: 900;
    font-size: 1.05em;
    line-height: 0.86;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: scaleX(1.24);
    transform-origin: center;
    background: linear-gradient(160deg, #7dffc7 8%, #18d383 46%, #0a7a4c 92%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 0 0.08em rgba(24, 211, 131, 0.55))
      drop-shadow(0 0 0.28em rgba(24, 211, 131, 0.28));
  }

  .wordmark__x {
    display: inline-block;
    font-size: 1.08em;
    line-height: 0.8;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
