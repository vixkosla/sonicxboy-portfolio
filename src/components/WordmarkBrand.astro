---
// Horizontal SONIC X BOY — uniform Tektur lockup, thick rim, cascade of
// solid salad-green cast shadows stepped ~70° down-right.
import '@fontsource-variable/tektur'

interface Props {
  href?: string
  label?: string
  class?: string
}

const {
  href = '/',
  label = 'SONIC X BOY — на главную',
  class: className,
} = Astro.props
---

<a class:list={['wordmark', className]} href={href} aria-label={label} title={label}>
  <span class="wordmark__frame">
    <span class="wordmark__plate">
      <span class="wordmark__text" aria-hidden="true">
        <span>SONIC</span>
        <span>X</span>
        <span>BOY</span>
      </span>
      <span class="visually-hidden">SONIC X BOY</span>
    </span>
  </span>
</a>

<style>
  .wordmark {
    --cut: 0.08em;
    --inset: 0.38em;
    --rim: 5px;
    /* Step along ~70° down-right (x ≈ 0.36 y) */
    --step: 0.13em;
    --sx: calc(var(--step) * 0.36);
    --sy: var(--step);
    position: relative;
    display: inline-block;
    line-height: 1;
    text-decoration: none;
    color: inherit;
    text-transform: uppercase;
    pointer-events: auto;
    transform: scaleX(1.24);
    transform-origin: center;
  }

  .wordmark__frame,
  .wordmark__plate {
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut)),
      0 var(--cut)
    );
  }

  .wordmark__frame {
    display: inline-block;
    padding: var(--rim);
    /* Broken / stepped salad rim — solid segments, not dashes */
    background:
      repeating-linear-gradient(
        115deg,
        #9dffd4 0 5px,
        #6cf3b3 5px 7px,
        #18d383 7px 13px,
        #0fb872 13px 15px,
        #0a7a4c 15px 20px
      );
    /* Soft halo + solid echo ladder down-right */
    filter:
      drop-shadow(0 0 0.06em rgba(125, 255, 199, 0.65))
      drop-shadow(calc(var(--sx) * 1) calc(var(--sy) * 1) 0 rgba(157, 255, 212, 0.95))
      drop-shadow(calc(var(--sx) * 2) calc(var(--sy) * 2) 0 rgba(108, 243, 179, 0.88))
      drop-shadow(calc(var(--sx) * 3) calc(var(--sy) * 3) 0 rgba(24, 211, 131, 0.78))
      drop-shadow(calc(var(--sx) * 4) calc(var(--sy) * 4) 0 rgba(15, 184, 114, 0.66))
      drop-shadow(calc(var(--sx) * 5) calc(var(--sy) * 5) 0 rgba(10, 122, 76, 0.52))
      drop-shadow(calc(var(--sx) * 6) calc(var(--sy) * 6) 0 rgba(8, 95, 58, 0.38))
      drop-shadow(calc(var(--sx) * 7) calc(var(--sy) * 7) 0 rgba(6, 70, 42, 0.24))
      drop-shadow(calc(var(--sx) * 8) calc(var(--sy) * 8) 0.35em rgba(24, 211, 131, 0.18));
    transition: filter 0.2s ease;
  }

  .wordmark:hover .wordmark__frame {
    filter:
      drop-shadow(0 0 0.1em rgba(125, 255, 199, 0.85))
      drop-shadow(calc(var(--sx) * 1) calc(var(--sy) * 1) 0 rgba(157, 255, 212, 1))
      drop-shadow(calc(var(--sx) * 2) calc(var(--sy) * 2) 0 rgba(108, 243, 179, 0.95))
      drop-shadow(calc(var(--sx) * 3) calc(var(--sy) * 3) 0 rgba(24, 211, 131, 0.88))
      drop-shadow(calc(var(--sx) * 4) calc(var(--sy) * 4) 0 rgba(15, 184, 114, 0.76))
      drop-shadow(calc(var(--sx) * 5) calc(var(--sy) * 5) 0 rgba(10, 122, 76, 0.62))
      drop-shadow(calc(var(--sx) * 6) calc(var(--sy) * 6) 0 rgba(8, 95, 58, 0.48))
      drop-shadow(calc(var(--sx) * 7) calc(var(--sy) * 7) 0 rgba(6, 70, 42, 0.32))
      drop-shadow(calc(var(--sx) * 8) calc(var(--sy) * 8) 0.45em rgba(24, 211, 131, 0.28));
  }

  .wordmark__plate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--inset);
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 0.36em,
        rgba(24, 211, 131, 0.05) calc(0.36em + 1px)
      ),
      linear-gradient(165deg, rgba(9, 26, 19, 0.97), rgba(4, 11, 8, 0.99));
  }

  .wordmark__text {
    display: inline-flex;
    align-items: baseline;
    gap: var(--inset);
    font-family: 'Tektur Variable', system-ui, sans-serif;
    font-size: 1em;
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: 0.02em;
    white-space: nowrap;
    background: linear-gradient(160deg, #7dffc7 8%, #18d383 46%, #0a7a4c 92%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    /* Same solid ladder on the letters */
    filter:
      drop-shadow(0 0 0.05em rgba(125, 255, 199, 0.55))
      drop-shadow(calc(var(--sx) * 1) calc(var(--sy) * 1) 0 rgba(157, 255, 212, 0.9))
      drop-shadow(calc(var(--sx) * 2) calc(var(--sy) * 2) 0 rgba(108, 243, 179, 0.75))
      drop-shadow(calc(var(--sx) * 3) calc(var(--sy) * 3) 0 rgba(24, 211, 131, 0.55))
      drop-shadow(calc(var(--sx) * 4) calc(var(--sy) * 4) 0 rgba(10, 122, 76, 0.35));
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
