---
// Horizontal SONIC X BOY — every letter shares the BrandMark X treatment.
// Tight chamfers, thick rim, cast shadow ~70° down-right in reactor green.
import '@fontsource-variable/tektur'

interface Props {
  href?: string
  label?: string
  class?: string
}

const {
  href = '/',
  label = 'SONIC X BOY — на главную',
  class: className,
} = Astro.props
---

<a class:list={['wordmark', className]} href={href} aria-label={label} title={label}>
  <span class="wordmark__frame">
    <span class="wordmark__plate">
      <span class="wordmark__text" aria-hidden="true">
        <span>SONIC</span>
        <span>X</span>
        <span>BOY</span>
      </span>
      <span class="visually-hidden">SONIC X BOY</span>
    </span>
  </span>
</a>

<style>
  .wordmark {
    /* Narrow corner cuts — not wide bevels */
    --cut: 0.09em;
    --inset: 0.4em;
    --rim: 5.5px;
    /* 70° from horizontal → mostly down, slight right */
    --sx: 0.28em;
    --sy: 0.78em;
    position: relative;
    display: inline-block;
    line-height: 1;
    text-decoration: none;
    color: inherit;
    text-transform: uppercase;
    pointer-events: auto;
    /* Stretch whole badge so inset stays equal on all sides */
    transform: scaleX(1.24);
    transform-origin: center;
  }

  .wordmark__frame,
  .wordmark__plate {
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut)),
      0 var(--cut)
    );
  }

  .wordmark__frame {
    display: inline-block;
    padding: var(--rim);
    background: linear-gradient(
      170deg,
      rgba(125, 255, 199, 0.98),
      rgba(24, 211, 131, 0.88) 42%,
      rgba(10, 122, 76, 0.92)
    );
    /* Brand glow + directional cast ~70° down-right */
    filter:
      drop-shadow(0 0 0.08em rgba(24, 211, 131, 0.7))
      drop-shadow(var(--sx) var(--sy) 0.22em rgba(24, 211, 131, 0.55))
      drop-shadow(
        calc(var(--sx) * 1.55) calc(var(--sy) * 1.55) 0.55em rgba(24, 211, 131, 0.38)
      )
      drop-shadow(
        calc(var(--sx) * 2.2) calc(var(--sy) * 2.2) 1.05em rgba(24, 211, 131, 0.22)
      );
    transition: filter 0.2s ease;
  }

  .wordmark:hover .wordmark__frame {
    filter:
      drop-shadow(0 0 0.12em rgba(24, 211, 131, 0.85))
      drop-shadow(var(--sx) var(--sy) 0.28em rgba(24, 211, 131, 0.7))
      drop-shadow(
        calc(var(--sx) * 1.55) calc(var(--sy) * 1.55) 0.7em rgba(24, 211, 131, 0.48)
      )
      drop-shadow(
        calc(var(--sx) * 2.2) calc(var(--sy) * 2.2) 1.25em rgba(24, 211, 131, 0.3)
      );
  }

  .wordmark__plate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Same inset on all sides */
    padding: var(--inset);
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 0.36em,
        rgba(24, 211, 131, 0.05) calc(0.36em + 1px)
      ),
      linear-gradient(165deg, rgba(9, 26, 19, 0.97), rgba(4, 11, 8, 0.99));
  }

  .wordmark__text {
    display: inline-flex;
    align-items: baseline;
    /* Letter gaps match the plate inset */
    gap: var(--inset);
    font-family: 'Tektur Variable', system-ui, sans-serif;
    font-size: 1em;
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: 0.02em;
    white-space: nowrap;
    background: linear-gradient(160deg, #7dffc7 8%, #18d383 46%, #0a7a4c 92%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 0 0.08em rgba(24, 211, 131, 0.55))
      drop-shadow(var(--sx) var(--sy) 0.18em rgba(24, 211, 131, 0.35));
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
