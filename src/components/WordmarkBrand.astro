---
// Horizontal SONIC X BOY — every letter shares the BrandMark X treatment
// (Tektur 900, stretch, emerald gradient + glow). Chamfered frame is
// thicker and carries the same glow as the letters.
import '@fontsource-variable/tektur'

interface Props {
  href?: string
  label?: string
  class?: string
}

const {
  href = '/',
  label = 'SONIC X BOY — на главную',
  class: className,
} = Astro.props
---

<a class:list={['wordmark', className]} href={href} aria-label={label} title={label}>
  <span class="wordmark__frame">
    <span class="wordmark__plate">
      <span class="wordmark__text" aria-hidden="true">
        <span>SONIC</span>
        <span>X</span>
        <span>BOY</span>
      </span>
      <span class="visually-hidden">SONIC X BOY</span>
    </span>
  </span>
</a>

<style>
  .wordmark {
    --cut: 0.28em;
    position: relative;
    display: inline-block;
    line-height: 1;
    text-decoration: none;
    color: inherit;
    text-transform: uppercase;
    pointer-events: auto;
    transition: filter 0.2s ease;
  }

  .wordmark:hover .wordmark__frame {
    filter:
      drop-shadow(0 0 0.12em rgba(24, 211, 131, 0.75))
      drop-shadow(0 0 0.45em rgba(24, 211, 131, 0.5))
      drop-shadow(0 0 1.1em rgba(24, 211, 131, 0.32));
  }

  .wordmark__frame,
  .wordmark__plate {
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut)),
      0 var(--cut)
    );
  }

  /* Thick emerald rim + same glow stack as the X letter */
  .wordmark__frame {
    display: inline-block;
    padding: 3.5px;
    background: linear-gradient(
      170deg,
      rgba(125, 255, 199, 0.95),
      rgba(24, 211, 131, 0.82) 42%,
      rgba(10, 122, 76, 0.88)
    );
    filter:
      drop-shadow(0 0 0.09em rgba(24, 211, 131, 0.55))
      drop-shadow(0 0 0.3em rgba(24, 211, 131, 0.3));
    transition: filter 0.2s ease;
  }

  .wordmark__plate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.32em 0.7em 0.36em;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 0.36em,
        rgba(24, 211, 131, 0.05) calc(0.36em + 1px)
      ),
      linear-gradient(165deg, rgba(9, 26, 19, 0.97), rgba(4, 11, 8, 0.99));
  }

  /* Uniform X-style letters across the whole lockup */
  .wordmark__text {
    display: inline-flex;
    align-items: baseline;
    gap: 0.32em;
    font-family: 'Tektur Variable', system-ui, sans-serif;
    font-size: 1em;
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transform: scaleX(1.24);
    transform-origin: center;
    background: linear-gradient(160deg, #7dffc7 8%, #18d383 46%, #0a7a4c 92%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 0 0.09em rgba(24, 211, 131, 0.55))
      drop-shadow(0 0 0.3em rgba(24, 211, 131, 0.3));
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
