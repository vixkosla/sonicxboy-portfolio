---
// Horizontal SONIC X BOY lockup — same Tektur X as BrandMark, but
// inline: dim side words + giant stretched emerald X, chamfered plate,
// no mid rules. Scales with parent font-size (same contract as BrandMark).
import '@fontsource-variable/tektur'
import '@fontsource-variable/jetbrains-mono'

interface Props {
  href?: string
  label?: string
  class?: string
}

const {
  href = '/',
  label = 'SONIC X BOY — на главную',
  class: className,
} = Astro.props
---

<a class:list={['wordmark', className]} href={href} aria-label={label} title={label}>
  <span class="wordmark__frame">
    <span class="wordmark__plate">
      <span class="wordmark__text" aria-hidden="true">
        <span class="wordmark__chunk">Sonic</span>
        <span class="wordmark__x">X</span>
        <span class="wordmark__chunk">Boy</span>
      </span>
      <span class="visually-hidden">SONIC X BOY</span>
    </span>
  </span>
</a>

<style>
  .wordmark {
    --cut: 0.5em;
    position: relative;
    display: inline-block;
    line-height: 1;
    text-decoration: none;
    color: var(--ink, #e8f5ee);
    text-transform: uppercase;
    pointer-events: auto;
    filter: drop-shadow(0 0 0.9em rgba(24, 211, 131, 0.16));
    transition: filter 0.2s ease;
  }

  .wordmark:hover {
    filter: drop-shadow(0 0 1.15em rgba(24, 211, 131, 0.42));
  }

  .wordmark__frame,
  .wordmark__plate {
    clip-path: polygon(
      var(--cut) 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut)),
      0 var(--cut)
    );
  }

  .wordmark__frame {
    display: inline-block;
    padding: 1.5px;
    background: linear-gradient(
      170deg,
      rgba(125, 255, 199, 0.85),
      rgba(24, 211, 131, 0.66) 42%,
      rgba(10, 122, 76, 0.72)
    );
  }

  .wordmark__plate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.28em 0.95em 0.32em;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 0.36em,
        rgba(24, 211, 131, 0.05) calc(0.36em + 1px)
      ),
      linear-gradient(165deg, rgba(9, 26, 19, 0.97), rgba(4, 11, 8, 0.99));
  }

  .wordmark__text {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    white-space: nowrap;
  }

  /* Side words: same mono treatment as BrandMark Sonic / Boy lines */
  .wordmark__chunk {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-weight: 800;
    font-size: 1.15em;
    line-height: 1;
    letter-spacing: 0.16em;
    margin-right: -0.16em;
    color: var(--ink, #e8f5ee);
  }

  /* Hero X — identical metrics to BrandMark */
  .wordmark__x {
    display: inline-block;
    font-family: 'Tektur Variable', system-ui, sans-serif;
    font-size: 4.35em;
    font-weight: 900;
    line-height: 0.78;
    transform: scaleX(1.24);
    transform-origin: center;
    background: linear-gradient(160deg, #7dffc7 8%, #18d383 46%, #0a7a4c 92%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 0 0.09em rgba(24, 211, 131, 0.55))
      drop-shadow(0 0 0.3em rgba(24, 211, 131, 0.3));
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
