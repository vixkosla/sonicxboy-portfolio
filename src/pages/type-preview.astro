---
import '@fontsource/monoton'
import '@fontsource/faster-one'
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <title>headline type preview</title>
    <style>
      body {
        margin: 0;
        display: grid;
        gap: 3.4rem;
        padding: 3rem;
        background: #050907;
        color: #e8f5ee;
      }
      .v {
        display: grid;
        gap: 0.8rem;
      }
      .v h1 {
        margin: 0;
        font-size: 4.6rem;
        font-weight: 400;
        line-height: 1;
        text-transform: uppercase;
      }
      .v h1 span {
        display: block;
      }
      .v h1 .l2 {
        color: #18d383;
      }
      .v small {
        font-family: monospace;
        color: #5a7a6b;
        font-size: 0.85rem;
      }
      .faster h1 { font-family: 'Faster One', system-ui; }
      .hybrid h1 { font-family: 'Faster One', system-ui; }
      .hybrid h1 .l1 { font-family: 'Monoton', system-ui; }
      .hybrid-rev h1 { font-family: 'Monoton', system-ui; }
      .hybrid-rev h1 .l2 { font-family: 'Faster One', system-ui; }
    </style>
  </head>
  <body>
    <div class="v faster">
      <h1><span class="l1">WebGL</span><span class="l2">Developer</span></h1>
      <small>Faster One — обе строки</small>
    </div>
    <div class="v hybrid">
      <h1><span class="l1">WebGL</span><span class="l2">Developer</span></h1>
      <small>Гибрид: Monoton (WEBGL) + Faster One (DEVELOPER) — как сейчас на сайте</small>
    </div>
    <div class="v hybrid-rev">
      <h1><span class="l1">WebGL</span><span class="l2">Developer</span></h1>
      <small>Гибрид наоборот: Faster One (WEBGL) + Monoton (DEVELOPER)</small>
    </div>
  </body>
</html>
