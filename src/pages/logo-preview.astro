---
import '@fontsource-variable/unbounded'
import '@fontsource-variable/tektur'
import '@fontsource/rubik-mono-one'
import BrandMark from '../components/BrandMark.astro'
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <title>logo preview</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        gap: 4rem;
        padding: 3rem;
        background: #050907;
        font-family: monospace;
      }
      .variant {
        display: grid;
        gap: 1.5rem;
        justify-items: center;
        color: #5a7a6b;
        font-size: 0.8rem;
      }
    </style>
  </head>
  <body>
    <div class="variant" style="font-size: 0.72rem">
      <BrandMark />
      <span>header size</span>
    </div>
    <div class="variant" style="font-size: 2.2rem">
      <BrandMark />
      <span>Unbounded</span>
    </div>
    <div class="variant" style="font-size: 2.2rem; --font-display: 'Tektur Variable', sans-serif">
      <BrandMark />
      <span>Tektur</span>
    </div>
    <div class="variant" style="font-size: 2.2rem; --font-display: 'Rubik Mono One', sans-serif">
      <BrandMark />
      <span>Rubik Mono One</span>
    </div>
  </body>
</html>
