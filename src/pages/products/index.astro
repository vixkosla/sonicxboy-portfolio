---
import ProductsShell from '../../layouts/ProductsShell.astro'
import { SITE } from '../../i18n.ts'
import { PRODUCTS } from '../../data/products.ts'

const title = 'Продукты SonicXBoy — Telegram MCP, Viewport Lab, РЖД и Tabby'
const description =
  'Инструменты для своей работы: Telegram MCP подключает личный Telegram к Claude Code и Codex, Viewport Lab показывает страницу в размерах телефона, планшета и ПК, скилл РЖД доводит свой билет до оплаты человеком, Tabby Agent Recovery возобновляет разговоры агентов в терминале.'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Продукты SonicXBoy',
  url: `${SITE}/products/`,
  description,
  inLanguage: 'ru',
  author: { '@type': 'Person', name: 'SonicXBoy', url: SITE },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: PRODUCTS.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: product.name,
      url: `${SITE}${product.href}`,
    })),
  },
}
---

<ProductsShell {title} {description} {schema} file={['README.md']} crumbs={[]}>
  <h1>Продукты</h1>
  <p class="lead">Инструменты для моей работы. Описание, установка и исходный код.</p>

  {PRODUCTS.map((product) => (
    <section class="entry" aria-labelledby={`product-${product.slug}`}>
      <h2 id={`product-${product.slug}`}>
        <a href={product.href}>{product.name}</a>
      </h2>
      <p>{product.summary}</p>
      <p class="entry__links">
        <a href={product.href}>Документация</a>
        <a
          href={product.install.href}
          rel={product.install.href.startsWith('http') ? 'noopener' : undefined}
        >Установка</a>
        <a href={product.source.href} rel="noopener">Исходный код</a>
      </p>
    </section>
  ))}
</ProductsShell>
