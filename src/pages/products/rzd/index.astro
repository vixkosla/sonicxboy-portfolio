---
import ProductsShell from '../../../layouts/ProductsShell.astro'
import ProductsPager from '../../../components/ProductsPager.astro'
import { RZD_CRUMB } from '../../../data/products.ts'
import { SITE } from '../../../i18n.ts'

const title = 'Билеты РЖД — скилл агента для своего заказа | SonicXBoy'
const description =
  'Скилл для ИИ-агента: поиск и заказ билета РЖД в уже открытой сессии. Оплату по QR СБП подтверждает человек, повторный билет не покупается, возврат только по отдельной просьбе.'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Билеты РЖД',
  url: `${SITE}/products/rzd/`,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Linux',
  inLanguage: 'ru',
  author: { '@type': 'Person', name: 'SonicXBoy', url: SITE },
  featureList: [
    'Поиск и заказ в уже открытой сессии личного кабинета',
    'Отдельный браузер, не повседневный',
    'Оплата по QR СБП остаётся за человеком',
    'Повторная покупка того же билета не начинается сама',
    'Возврат только по отдельной просьбе',
  ],
}
---

<ProductsShell
  {title}
  {description}
  {schema}
  file={['rzd', 'README.md']}
  crumbs={[RZD_CRUMB]}
>
  <h1>Билеты РЖД</h1>
  <ul class="badges" aria-label="Характеристики">
    <li>скилл</li>
    <li>агент</li>
    <li>свой аккаунт</li>
    <li>оплата вручную</li>
  </ul>
  <p class="lead">
    Скилл, по которому агент доводит мой билет на сайте РЖД от поиска до
    готового заказа. Деньги списываю я: агент останавливается на QR СБП.
  </p>

  <h2>Зачем</h2>
  <p>
    Без отдельного сценария агент открывает новый браузер, теряет вход и легко
    принимает прошлое согласие за разрешение купить ещё один билет или оформить
    возврат. Скилл держит одну проверенную цепочку: существующая сессия, один
    заказ, оплата и возврат только по прямой просьбе.
  </p>

  <h2>Что умеет</h2>
  <ul>
    <li>
      <strong>Свой кабинет</strong> — отдельный Chrome, в котором вход уже
      выполнен. Повседневный браузер для этого не используется.
    </li>
    <li><strong>Заказ</strong> — поиск поезда и оформление до страницы оплаты.</li>
    <li>
      <strong>Оплата</strong> — QR СБП. Подтверждаю его я, агент оплату не
      проводит.
    </li>
    <li>
      <strong>Один билет</strong> — согласие на прошлую покупку не разрешает
      купить дубль.
    </li>
    <li>
      <strong>Возврат</strong> — только если я попросил вернуть именно этот
      билет. Покупка и возврат считаются готовыми после подтверждения на сайте.
    </li>
  </ul>

  <h2>Границы</h2>
  <ul>
    <li>Чужой аккаунт, чужой пассажир и чужой заказ не используются.</li>
    <li>Код из СМС и банковское подтверждение остаются у меня.</li>
    <li>Это записи о своих поездках, не касса и не сервис для чужих билетов.</li>
    <li>
      Рабочий сценарий остаётся на этой машине. На сайте нет сессии, профиля и
      служебных шагов.
    </li>
  </ul>

  <h2>Статус</h2>
  <p>
    Сценарий проверен на реальных билетах Петербург — Москва в обе стороны,
    включая возврат по отдельной просьбе.
  </p>

  <ProductsPager />
</ProductsShell>
